---
/**
 * Landing page : un seul écran, sans défilement, du petit mobile au grand écran.
 * Une variante par angle publicitaire (src/contenu/landings.ts), chacune à son adresse :
 * /inscription, /inscription/mariages, /inscription/garantie…
 *
 * Tout tient dans la hauteur visible (100svh). La photo occupe la place restante :
 * elle grandit sur les grands téléphones et s'efface sur les plus petits, pour que
 * la promesse, le formulaire et les avis restent toujours à l'écran.
 */
import { Image, Picture } from 'astro:assets';
import Tunnel from '../../layouts/Tunnel.astro';
import FormulaireLead from '../../components/FormulaireLead.astro';
import AvisTrustpilot from '../../components/AvisTrustpilot.astro';
import logo from '../../assets/logo-academie-florale.png';
import photo from '../../assets/sybile-bouquet.jpg';
import { LANDINGS, type Landing } from '../../contenu/landings';
import { CHEMINS, LIENS_LEGAUX, MARQUE, MENTION_META } from '../../reglages';

export function getStaticPaths() {
  return LANDINGS.map((landing) => ({
    params: { variante: landing.slug || undefined },
    props: { landing },
  }));
}

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const liens = LIENS_LEGAUX.filter((lien) => lien.adresse);
const confidentialite = LIENS_LEGAUX.find((lien) => lien.libelle === 'Confidentialité' && lien.adresse);
const page = landing.slug ? `inscription/${landing.slug}` : 'inscription';

// « *90 jours* » devient un passage mis en valeur, sans jamais injecter de HTML.
const morceaux = landing.titre.split('*').map((texte, i) => ({ texte, fort: i % 2 === 1 }));
---

<Tunnel titre={landing.titrePage} description={landing.description} enTete={false} pied="aucun">
  <div class="ecran">
    <header class="tete">
      <Image src={logo} alt={MARQUE} width={120} densities={[1, 2, 3]} loading="eager" class="logo" />
    </header>

    <div class="promesse">
      <p class="surtitre">{landing.surtitre}</p>
      <h1>{morceaux.map((m) => (m.fort ? <em>{m.texte}</em> : m.texte))}</h1>
      <p class="sous-titre">{landing.sousTitre}</p>
    </div>

    <figure class="photo">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 1096]}
        sizes="(min-width: 1000px) 28vw, (min-width: 600px) 528px, 92vw"
        alt="Sybile Loppé, fondatrice de l’Académie Florale, un grand bouquet orange dans les bras"
        loading="eager"
        fetchpriority="high"
      />
      {landing.repere && <figcaption class="repere">{landing.repere}</figcaption>}
    </figure>

    <div class="formulaire">
      <p class="titre-formulaire">Où t’envoyer la vidéo ?</p>
      <FormulaireLead
        id="inscription"
        compact
        suivant={CHEMINS.video}
        bouton={landing.bouton}
        source={landing.source}
        page={page}
        avecTelephone={landing.avecTelephone}
      >
        <p slot="mention" class="mention">
          Tu reçois la vidéo et les conseils de l’Académie Florale par email. Désinscription en un clic.
          {
            confidentialite && (
              <a href={confidentialite.adresse} target="_blank" rel="noopener">
                Confidentialité
              </a>
            )
          }
        </p>
      </FormulaireLead>
    </div>

    <div class="zone-avis">
      <AvisTrustpilot />
    </div>

    <footer class="pied">
      <p class="liens">
        {
          liens.map((lien) => (
            <a href={lien.adresse} target="_blank" rel="noopener">
              {lien.libelle}
            </a>
          ))
        }
      </p>
      <p>{MENTION_META} © {MARQUE}.</p>
    </footer>
  </div>
</Tunnel>

<style>
  .ecran {
    --pas: clamp(5px, 1.2svh, 12px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr) auto auto auto;
    grid-template-areas:
      'tete'
      'promesse'
      'photo'
      'formulaire'
      'avis'
      'pied';
    gap: var(--pas);
    width: 100%;
    max-width: 560px;
    height: 100vh;
    height: 100svh;
    margin-inline: auto;
    padding: max(8px, env(safe-area-inset-top)) var(--marge-page) max(6px, env(safe-area-inset-bottom));
  }

  .tete {
    grid-area: tete;
    display: flex;
    justify-content: center;
  }

  .logo {
    width: auto;
    height: clamp(22px, 4.4svh, 36px);
  }

  .promesse {
    grid-area: promesse;
    display: grid;
    gap: clamp(3px, 0.8svh, 8px);
    text-align: center;
  }

  .surtitre {
    color: var(--encre-douce);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(1.45rem, min(7.3vw, 4.3svh), 2.1rem);
    line-height: 1.1;
  }

  /* Le passage mis en valeur ne se coupe jamais en deux lignes (« 90 jours »). */
  h1 em {
    white-space: nowrap;
  }

  .sous-titre {
    font-size: clamp(0.875rem, min(4vw, 2.4svh), 1.0625rem);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .photo {
    grid-area: photo;
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 24%;
  }

  .repere {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--jaune);
    color: var(--encre);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .formulaire {
    grid-area: formulaire;
    display: grid;
    gap: 6px;
  }

  .titre-formulaire {
    display: none;
  }

  .mention {
    color: var(--encre-douce);
    font-size: 0.6875rem;
    line-height: 1.3;
    text-align: center;
    text-wrap: pretty;
  }

  .zone-avis {
    grid-area: avis;
    min-width: 0;
  }

  .pied {
    grid-area: pied;
    color: var(--encre-douce);
    font-size: 0.625rem;
    line-height: 1.3;
    text-align: center;
  }

  .liens {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-bottom: 1px;
    font-size: 0.6875rem;
  }

  /* Petits écrans en hauteur (navigateur intégré d'Instagram sur un petit téléphone) :
     la photo s'efface, tout le reste reste à l'écran. */
  @media (max-height: 590px) {
    .ecran {
      grid-template-rows: auto auto auto auto auto;
      grid-template-areas:
        'tete'
        'promesse'
        'formulaire'
        'avis'
        'pied';
      align-content: space-between;
    }

    .photo {
      display: none;
    }
  }

  /* Téléphone à l'horizontale : promesse à gauche, formulaire à droite. */
  @media (min-width: 620px) and (max-height: 520px) {
    .ecran {
      max-width: 900px;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        'tete tete'
        'promesse formulaire'
        'avis formulaire'
        'pied pied';
      column-gap: 24px;
    }

    .formulaire {
      align-self: center;
    }
  }

  /* Grand écran : promesse et avis à gauche, Sybile au centre, formulaire à droite. */
  @media (min-width: 1000px) and (min-height: 521px) {
    .ecran {
      max-width: min(1560px, 94vw);
      padding: clamp(14px, 2.6svh, 28px) clamp(20px, 2.5vw, 48px) clamp(8px, 1.6svh, 16px);
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.8fr) minmax(360px, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        'tete tete tete'
        'promesse photo formulaire'
        'avis photo formulaire'
        'pied pied pied';
      column-gap: clamp(24px, 3.2vw, 60px);
      row-gap: clamp(10px, 2.2svh, 24px);
    }

    .tete {
      justify-content: flex-start;
    }

    .logo {
      height: clamp(34px, 6svh, 52px);
    }

    .promesse {
      gap: clamp(8px, 1.8svh, 18px);
      padding-top: clamp(0px, 3svh, 36px);
      text-align: left;
    }

    .surtitre {
      font-size: 0.8125rem;
    }

    h1 {
      font-size: clamp(2rem, min(3.5vw, 6.6svh), 4.2rem);
    }

    .sous-titre {
      max-width: 36ch;
      font-size: clamp(1rem, min(1.4vw, 2.7svh), 1.5rem);
    }

    .photo {
      display: block;
      align-self: center;
      height: min(100%, 76svh);
      border-radius: 999px 999px 26px 26px;
    }

    .photo :global(img) {
      object-position: 50% 30%;
    }

    .repere {
      left: 50%;
      bottom: 16px;
      width: max-content;
      max-width: calc(100% - 24px);
      padding: 7px 14px;
      font-size: 0.8125rem;
      text-align: center;
      transform: translateX(-50%);
    }

    .formulaire {
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 500px;
      gap: clamp(10px, 1.8svh, 18px);
      padding: clamp(20px, 3.6svh, 40px);
      border: 1px solid var(--trait);
      border-radius: 26px;
      background: var(--blanc);
      box-shadow: 0 30px 80px -36px var(--ombre);
    }

    .titre-formulaire {
      display: block;
      font-family: var(--police-titres);
      font-size: clamp(1.3rem, min(1.9vw, 3.6svh), 2rem);
      font-weight: 600;
      line-height: 1.15;
    }

    /* Champs et bouton plus généreux sur grand écran. */
    .formulaire :global(.formulaire-lead) {
      gap: clamp(8px, 1.5svh, 14px);
    }

    .formulaire :global(.champ input) {
      min-height: clamp(52px, 7.4svh, 64px);
      padding-top: clamp(20px, 3svh, 26px);
      background: var(--creme);
      font-size: 1.0625rem;
    }

    .formulaire :global(.champ label) {
      top: clamp(7px, 1.2svh, 11px);
      font-size: 0.75rem;
    }

    .formulaire :global(.bouton) {
      min-height: clamp(54px, 7.6svh, 66px);
      font-size: clamp(1.1875rem, 1.5vw, 1.4rem);
    }

    .mention {
      font-size: 0.8125rem;
      text-align: left;
    }

    .pied {
      font-size: 0.6875rem;
    }
  }
</style>
