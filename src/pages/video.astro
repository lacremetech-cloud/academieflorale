---
/**
 * Page VSL : emplacement provisoire.
 * La vraie page (vidéo Wistia, bouton de réservation) se construit à l'étape suivante.
 * Cet emplacement évite une page introuvable après l'envoi du formulaire de la landing.
 */
import Tunnel from '../layouts/Tunnel.astro';
---

<Tunnel titre="Ta vidéo · Académie Florale" pied="compact">
  <div class="conteneur conteneur-texte page">
    <h1>
      <span data-sans-prenom>C’est noté</span>
      <span data-si-prenom hidden>C’est noté, <em data-prenom></em></span>
    </h1>
    <p>La page de la vidéo est la prochaine étape de la refonte : elle n’est pas encore construite.</p>
    <p class="texte-secondaire">Emplacement provisoire, non indexé.</p>
  </div>
</Tunnel>

<style>
  .page {
    display: grid;
    gap: 14px;
    padding-block: 32px 64px;
    text-align: center;
  }
</style>
