---
/**
 * Page VSL : la vidéo de vente, puis un seul bouton vers la réservation de l'appel.
 * Titre, vidéo et bouton tiennent dans le premier écran, sur mobile comme sur ordinateur.
 * Rien d'autre ne détourne l'attention.
 *
 * Le titre reprend le prénom saisi sur la landing. Sans prénom (arrivée par un
 * email, autre appareil), la version neutre s'affiche : la page fonctionne aussi
 * pour une visiteuse qui n'est pas passée par le formulaire.
 */
import Tunnel from '../layouts/Tunnel.astro';
import VideoWistia from '../components/VideoWistia.astro';
import apercu from '../assets/vsl-apercu.jpg';
import { CHEMINS, WISTIA } from '../reglages';
---

<Tunnel
  titre="Ta vidéo · Académie Florale"
  description="La vidéo de Sybile Loppé : devenir fleuriste indépendante en 90 jours, depuis chez toi."
  pied="compact"
>
  <div class="conteneur page">
    <div class="accroche">
      <h1>
        <span data-sans-prenom>Voici ta vidéo</span>
        <span data-si-prenom hidden><em data-prenom></em>, voici ta vidéo</span>
      </h1>
      <p class="sous-titre">
        10 minutes avec Sybile pour comprendre comment devenir fleuriste indépendante en 90 jours, depuis chez toi.
      </p>
    </div>

    <div class="cadre">
      <VideoWistia media={WISTIA.vsl} apercu={apercu} sujet="devenir fleuriste indépendante en 90 jours" />
    </div>

    <div class="action">
      <a class="bouton" href={CHEMINS.call} data-tunnel>Je réserve mon appel de découverte</a>
      <p class="texte-secondaire">Appel offert, pour faire le point sur ton projet.</p>
    </div>
  </div>
</Tunnel>

<style>
  .page {
    display: grid;
    justify-items: center;
    gap: clamp(10px, 2.2svh, 22px);
    padding-bottom: clamp(14px, 3svh, 32px);
    text-align: center;
  }

  .accroche {
    display: grid;
    gap: clamp(4px, 1svh, 10px);
    max-width: 46rem;
  }

  h1 {
    font-size: clamp(1.5rem, min(6.6vw, 4.6svh), 2.6rem);
  }

  .sous-titre {
    font-size: clamp(0.9rem, min(3.9vw, 2.5svh), 1.2rem);
    line-height: 1.35;
    text-wrap: pretty;
  }

  /* La vidéo prend la largeur disponible, sans jamais pousser le bouton hors de l'écran :
     sa hauteur est bornée par celle de la fenêtre. */
  .cadre {
    width: min(100%, 900px, calc((100svh - 340px) * 16 / 9));
    min-width: min(100%, 300px);
  }

  .action {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 100%;
  }

  .action .bouton {
    width: min(100%, 26rem);
  }

  @media (max-width: 600px) {
    .cadre {
      width: min(100%, calc((100svh - 330px) * 16 / 9));
    }
  }

  /* Petits écrans en hauteur : on resserre pour garder le bouton visible. */
  @media (max-height: 600px) {
    .page {
      gap: 8px;
    }

    .sous-titre {
      font-size: 0.86rem;
      line-height: 1.3;
    }

    .action .texte-secondaire {
      font-size: 0.75rem;
    }
  }

  /* Téléphone à l'horizontale : le titre, la vidéo et le bouton, rien d'autre. */
  @media (max-height: 440px) {
    .sous-titre {
      display: none;
    }
  }
</style>
