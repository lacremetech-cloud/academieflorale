</style>

<script>
  import { indicateurs, moisCourant, moisDecale, moisValide, totaliser } from '../../../partage/cockpit.js';
  import { classerPubs, indicateursPub, parJourDeSemaine, resultats, totaliserPubs, trierPubs, tunnelParle, VERDICTS } from '../../../partage/pubs.js';
  import { echeancier, FORMULES, lireMontant, METHODES, normaliserVente } from '../../../partage/ventes.js';

  type Chiffres = Record<string, number | null>;
  type Jour = Chiffres & { date: string };
  type Source = {
    nom: string;
    etat: 'ok' | 'a-brancher' | 'erreur';
    detail: string;
    variables: string[];
    brancher?: string;
    precision?: string;
    manuel?: boolean;
  };
  type Paiement = { methode: string; montant: number; mensualites: number; debut: string };
  type Vente = {
    id: string;
    date: string;
    formule: string;
    montant: number;
    commission: number;
    closer: string;
    closerNom: string;
    paiements: Paiement[];
    note?: string;
    email?: string;
    /** Ce que la vente a déclenché : liste « Client », événement « Achat », publicité d'arrivée. */
    suivi?: { ac?: string; meta?: string; pub?: string };
    encaisse: number;
    reste: number;
  };
  type Closer = { id: string; nom: string };
  /** Un maillon du suivi du tunnel (ActiveCampaign, rendez-vous, API de conversion…). */
  type Maillon = { nom: string; etat: 'ok' | 'a-brancher' | 'attente' | 'erreur'; lignes: string[]; variables?: string[] };
  type SourcePub = 'tunnel' | 'meta';
  type ResultatsTunnel = { inscrites: number; rdv: number; rdvAnnules: number; ventes: number; commande: number; encaisse: number };
  type LignePub = {
    cle: string;
    nom: string;
    ids: string[];
    campagnes: string[];
    ensembles: number;
    statut: string;
    creeLe: string;
    titre: string;
    texte: string;
    vignette: string;
    depense: number;
    impressions: number;
    clics: number;
    vues3s: number;
    vuesCompletes: number;
    meta: { prospects: number; rdv: number; achats: number; valeur: number };
    tunnel: ResultatsTunnel;
  };
  type RapportPubs = {
    mois: string;
    periode: string;
    du: string;
    au: string;
    demonstration: boolean;
    campagnes: string;
    parametres: string;
    etats: Record<'meta' | 'tunnel' | 'iclosed', 'ok' | 'a-brancher' | 'erreur'>;
    details: Record<string, string>;
    pubs: LignePub[];
    sansPub: ResultatsTunnel | null;
    jours: { date: string; depense: number; clics: number; prospects: number; inscrites: number; rdv: number; ventes: number; commande: number }[];
    heures: { heure: number; depense: number; clics: number; prospects: number; inscrites: number }[];
    delais: { rdv: Record<string, number>; vente: Record<string, number>; tranches: { cle: string; nom: string }[] };
  };
  /** Ce que le serveur rend après chaque changement dans les ventes. */
  type BlocVentes = {
    jours: Record<string, { ventes: number; contracte: number; encaisse: number }>;
    ventes: Vente[];
    closers: Closer[];
    encaissements: { mois: string; total: number; encaisse: number; parMethode: Record<string, number> }[];
    aEncaisser: number;
    commissions: { closer: string; nom: string; ventes: number; contracte: number; commission: number }[];
  };
  type Donnees = Omit<BlocVentes, 'jours'> & {
    mois: string;
    aujourdHui: string;
    demonstration: boolean;
    jours: Jour[];
    notes: Record<string, string>;
    variantes: { nom: string; vues: number; inscrits: number }[];
    campagnes: string;
    sources: Record<string, Source>;
    suivi?: Record<string, Maillon>;
  };
  type Format = 'euros' | 'centimes' | 'entier' | 'pourcent' | 'ratio' | 'minutes';
  type Colonne = {
    cle: string;
    titre: string;
    aide: string;
    format: Format;
    /** Lit la valeur dans les chiffres bruts et les indicateurs d'une ligne. */
    lire?: (bruts: Chiffres, calcules: ReturnType<typeof indicateurs>) => number | null;
    vente?: boolean;
  };

  const API = '/api/cockpit';
  const PREMIER_MOIS = '2026-01';

  /* ---------- Les colonnes de chaque partie : les noms du tableau publicitaire ---------- */

  const brut = (cle: string) => (bruts: Chiffres) => bruts[cle] ?? null;
  const calcule = (cle: keyof ReturnType<typeof indicateurs>) => (_: Chiffres, calcules: ReturnType<typeof indicateurs>) =>
    calcules[cle];

  const COLONNES: Record<string, Colonne[]> = {
    acquisition: [
      { cle: 'depense', titre: 'Dépense', aide: 'Dépense publicitaire (Meta Ads)', format: 'euros', lire: brut('depense') },
      { cle: 'impressions', titre: 'Imp.', aide: 'Impressions des publicités', format: 'entier', lire: brut('impressions') },
      { cle: 'clics', titre: 'Clics', aide: 'Clics sur le lien des publicités', format: 'entier', lire: brut('clics') },
      { cle: 'cpm', titre: 'CPM', aide: 'Coût pour 1 000 impressions', format: 'centimes', lire: calcule('cpm') },
      { cle: 'ctr', titre: 'CTR', aide: 'Clics ÷ impressions', format: 'pourcent', lire: calcule('ctr') },
      { cle: 'cpc', titre: 'CPC', aide: 'Dépense ÷ clics', format: 'centimes', lire: calcule('cpc') },
      { cle: 'inscrits', titre: 'Inscrits', aide: 'Formulaires de la landing envoyés', format: 'entier', lire: brut('inscrits') },
      { cle: 'cpp', titre: 'CPP', aide: 'Coût par inscrite : dépense ÷ inscrits', format: 'centimes', lire: calcule('cpp') },
      { cle: 'tauxInscription', titre: '% PI', aide: 'Page d’inscription : inscrits ÷ clics', format: 'pourcent', lire: calcule('tauxInscription') },
    ],
    vsl: [
      { cle: 'inscrits', titre: 'Inscrits', aide: 'Formulaires de la landing envoyés', format: 'entier', lire: brut('inscrits') },
      { cle: 'chargements', titre: 'Charg.', aide: 'Chargements de la vidéo (Wistia)', format: 'entier', lire: brut('chargements') },
      { cle: 'lectures', titre: 'Lectures', aide: 'Lectures de la vidéo (Wistia)', format: 'entier', lire: brut('lectures') },
      { cle: 'tauxLecture', titre: '% Lect.', aide: 'Lectures ÷ chargements', format: 'pourcent', lire: calcule('tauxLecture') },
      { cle: 'minutesVues', titre: 'Min. vues', aide: 'Minutes regardées par lecture, en moyenne (la vidéo dure 10 min 31)', format: 'minutes', lire: calcule('minutesVues') },
      { cle: 'partVue', titre: '% Vidéo', aide: 'Part de la vidéo regardée, en moyenne', format: 'pourcent', lire: calcule('partVue') },
      { cle: 'appels', titre: 'Appels', aide: 'Appels réservés, à leur date de réservation (iClosed)', format: 'entier', lire: brut('appels') },
      { cle: 'tauxAppel', titre: '% Appel', aide: 'Appels réservés ÷ inscrits (le « % Webi. » du tableau d’origine)', format: 'pourcent', lire: calcule('tauxAppel') },
      { cle: 'cpa', titre: 'CPA', aide: 'Coût par appel réservé : dépense ÷ appels', format: 'euros', lire: calcule('cpa') },
    ],
    closing: [
      { cle: 'appels', titre: 'Appels', aide: 'Appels réservés, à leur date de réservation', format: 'entier', lire: brut('appels') },
      { cle: 'annules', titre: 'C. Calls', aide: 'Appels annulés, au jour où ils étaient prévus', format: 'entier', lire: brut('annules') },
      { cle: 'tauxAnnulation', titre: '% Canc.', aide: 'Annulés ÷ appels réservés', format: 'pourcent', lire: calcule('tauxAnnulation') },
      { cle: 'maintenus', titre: 'Q. Calls', aide: 'Appels maintenus : réservés moins annulés', format: 'entier', lire: calcule('maintenus') },
      { cle: 'cpaMaintenu', titre: 'Q. CPA', aide: 'Dépense ÷ appels maintenus', format: 'euros', lire: calcule('cpaMaintenu') },
      { cle: 'absentes', titre: 'Absentes', aide: 'Appels où la prospecte ne s’est pas présentée, au jour prévu', format: 'entier', lire: brut('absentes') },
      { cle: 'ventes', titre: 'Ventes', aide: 'Ventes enregistrées', format: 'entier', lire: brut('ventes'), vente: true },
      { cle: 'tauxClosing', titre: '% Close', aide: 'Ventes ÷ appels maintenus', format: 'pourcent', lire: calcule('tauxClosing') },
      { cle: 'contracte', titre: 'Commandé', aide: 'Montant des ventes', format: 'euros', lire: brut('contracte') },
      { cle: 'encaisse', titre: 'Encaissé', aide: 'Déjà encaissé sur ces ventes, d’après leur échéancier', format: 'euros', lire: brut('encaisse') },
      { cle: 'reste', titre: 'Reste', aide: 'Reste à encaisser sur ces ventes : commandé moins encaissé', format: 'euros', lire: calcule('reste') },
      { cle: 'cpv', titre: 'CPV', aide: 'Coût par vente : dépense ÷ ventes', format: 'euros', lire: calcule('cpv') },
      { cle: 'roas', titre: 'ROAS', aide: 'Commandé ÷ dépense', format: 'ratio', lire: calcule('roas') },
      { cle: 'roasDirect', titre: 'D. ROAS', aide: 'Encaissé ÷ dépense', format: 'ratio', lire: calcule('roasDirect') },
    ],
  };

  /** Les chiffres du mois mis en avant, par partie. */
  const CARTES: Record<string, string[]> = {
    acquisition: ['depense', 'inscrits', 'cpp', 'tauxInscription', 'cpm', 'ctr', 'cpc'],
    vsl: ['lectures', 'tauxLecture', 'partVue', 'appels', 'tauxAppel', 'cpa'],
    closing: ['ventes', 'tauxClosing', 'contracte', 'encaisse', 'cpv', 'roas', 'roasDirect'],
  };

  /* ---------- Mise en forme ---------- */

  const nombre = (options: Intl.NumberFormatOptions) => new Intl.NumberFormat('fr-FR', options);
  const FORMATS: Record<Format, Intl.NumberFormat> = {
    euros: nombre({ style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }),
    centimes: nombre({ style: 'currency', currency: 'EUR', minimumFractionDigits: 1, maximumFractionDigits: 1 }),
    entier: nombre({ maximumFractionDigits: 0 }),
    pourcent: nombre({ style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }),
    ratio: nombre({ minimumFractionDigits: 1, maximumFractionDigits: 1 }),
    minutes: nombre({ minimumFractionDigits: 1, maximumFractionDigits: 1 }),
  };
  const ecrire = (valeur: number | null, format: Format) =>
    valeur == null || !Number.isFinite(valeur) ? '—' : FORMATS[format].format(valeur) + (format === 'minutes' ? ' min' : '');

  const jourSemaine = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', timeZone: 'UTC' });
  const nomDuMois = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const libelleJour = (date: string) => `${jourSemaine.format(new Date(`${date}T12:00:00Z`))} ${date.slice(8)}/${date.slice(5, 7)}`;
  const libelleMois = (mois: string) => nomDuMois.format(new Date(`${mois}-15T12:00:00Z`));
  /** « de novembre 2026 », « d’octobre 2026 » : l'élision devant une voyelle. */
  const deMois = (mois: string) => (/^[aeiouyàâéèêîôûh]/i.test(libelleMois(mois)) ? `d’${libelleMois(mois)}` : `de ${libelleMois(mois)}`);

  const creer = <K extends keyof HTMLElementTagNameMap>(balise: K, texte = '', classe = '') => {
    const element = document.createElement(balise);
    if (texte) element.textContent = texte;
    if (classe) element.className = classe;
    return element;
  };
  const $ = <T extends HTMLElement>(selecteur: string) => document.querySelector<T>(selecteur);

  /* ---------- État de la page ---------- */

  const porte = $('[data-porte]');
  const tableau = $('[data-tableau]');
  const attente = $('[data-attente]');
  const message = $('[data-message]');
  const erreur = $('[data-erreur]');
  const choixMois = $<HTMLSelectElement>('[data-mois]');
  const textePorte = $('[data-porte-texte]');
  const connexion = $<HTMLFormElement>('[data-connexion]');
  /** L'invitation d'origine de la porte, remise dès que le cockpit peut s'ouvrir. */
  const invitation = textePorte?.textContent ?? '';
  let mois = new URLSearchParams(window.location.search).get('mois') ?? '';
  if (!moisValide(mois)) mois = moisCourant();
  let donnees: Donnees | null = null;

  const montrer = (quoi: 'porte' | 'tableau' | 'attente') => {
    if (porte) porte.hidden = quoi !== 'porte';
    if (tableau) tableau.hidden = quoi !== 'tableau';
    if (attente) attente.hidden = quoi !== 'attente';
  };

  /* ---------- Affichage ---------- */

  function afficherSources(sources: Record<string, Source>, campagnes: string) {
    const liste = $('[data-sources]');
    if (!liste) return;
    liste.replaceChildren(
      ...Object.entries(sources).map(([cle, source]) => {
        const ligne = creer('li', '', source.etat === 'ok' ? 'ok' : source.etat === 'erreur' ? 'erreur-source' : 'a-brancher');
        ligne.append(creer('strong', source.nom));
        const pret = source.manuel ? '✓ Enregistrées ici' : '✓ Branché';
        ligne.append(creer('span', source.etat === 'ok' ? pret : source.etat === 'erreur' ? '✕ En erreur' : '○ À brancher', 'etat'));
        if (source.etat === 'erreur' && source.detail) ligne.append(creer('span', source.detail, 'detail'));
        if (source.etat === 'ok' && source.manuel) ligne.append(creer('span', 'Bouton « Ajouter une vente », dans le Closing', 'detail'));
        if (source.etat === 'ok' && source.precision) ligne.append(creer('span', source.precision, 'detail'));
        if (source.etat === 'a-brancher' && source.brancher) {
          ligne.append(creer('span', source.brancher, 'detail'));
        } else if (source.etat === 'a-brancher') {
          const detail = creer('span', 'Variables à saisir dans Vercel : ', 'detail');
          source.variables.forEach((variable, rang) => {
            if (rang > 0) detail.append(', ');
            detail.append(creer('code', variable));
          });
          ligne.append(detail);
        }
        if (cle === 'meta' && source.etat === 'ok') {
          ligne.append(creer('span', campagnes ? `Campagnes dont le nom contient « ${campagnes} »` : 'Tout le compte publicitaire', 'detail'));
        }
        return ligne;
      }),
    );
  }

  /** Les maillons du tunnel : en place, en attente, à brancher ou en erreur. */
  function afficherSuivi(suivi: Record<string, Maillon> | undefined) {
    const bloc = $('[data-bloc-suivi]');
    const liste = $('[data-suivi]');
    if (!bloc || !liste) return;
    const maillons = Object.entries(suivi ?? {});
    bloc.hidden = maillons.length === 0;
    const libelles = { ok: '✓ En place', attente: '○ En attente', 'a-brancher': '○ À brancher', erreur: '✕ À corriger' };
    liste.replaceChildren(
      ...maillons.map(([cle, maillon]) => {
        const ligne = creer('li', '', maillon.etat === 'erreur' ? 'erreur-source' : maillon.etat);
        ligne.dataset.maillon = cle;
        ligne.append(creer('strong', maillon.nom), creer('span', libelles[maillon.etat] ?? '', 'etat'));
        for (const texte of maillon.lignes) ligne.append(creer('span', texte, 'detail'));
        if (maillon.etat === 'a-brancher' && maillon.variables?.length) {
          const detail = creer('span', 'Variables à saisir dans Vercel : ', 'detail');
          maillon.variables.forEach((variable, rang) => {
            if (rang > 0) detail.append(', ');
            detail.append(creer('code', variable));
          });
          ligne.append(detail);
        }
        return ligne;
      }),
    );
  }

  function afficherCartes(partie: string, total: Chiffres) {
    const liste = $(`[data-cartes="${partie}"]`);
    if (!liste) return;
    const calcules = indicateurs(total);
    liste.replaceChildren(
      ...(CARTES[partie] ?? []).map((cle) => {
        const colonne = Object.values(COLONNES)
          .flat()
          .find((c) => c.cle === cle);
        const carte = creer('li');
        if (!colonne) return carte;
        carte.append(creer('span', colonne.titre, 'libelle'));
        carte.append(creer('span', ecrire(colonne.lire?.(total, calcules) ?? null, colonne.format), 'valeur'));
        carte.append(creer('span', colonne.aide, 'precision'));
        return carte;
      }),
    );
  }

  function afficherTable(partie: string, d: Donnees, total: Chiffres) {
    const table = $(`[data-table="${partie}"]`);
    const colonnes = COLONNES[partie];
    if (!table || !colonnes) return;
    const avecNotes = partie === 'acquisition';

    const enTete = creer('tr');
    enTete.append(creer('th', 'Jour'));
    for (const colonne of colonnes) {
      const cellule = creer('th', colonne.titre);
      cellule.title = colonne.aide;
      cellule.scope = 'col';
      enTete.append(cellule);
    }
    if (avecNotes) enTete.append(creer('th', 'Notes'));
    const tete = creer('thead');
    tete.append(enTete);

    const corps = creer('tbody');
    for (const jour of d.jours) {
      // Les jours à venir n'apportent rien : le tableau s'arrête à aujourd'hui.
      if (jour.date > d.aujourdHui) continue;
      const ligne = creer('tr');
      const date = new Date(`${jour.date}T12:00:00Z`);
      if (date.getUTCDay() === 0) ligne.classList.add('dimanche');
      if (jour.date === d.aujourdHui) ligne.classList.add('aujourd-hui');
      ligne.append(creer('td', libelleJour(jour.date)));
      const calcules = indicateurs(jour);
      for (const colonne of colonnes) {
        const valeur = colonne.lire?.(jour, calcules) ?? null;
        const cellule = creer('td', ecrire(valeur, colonne.format), valeur == null ? 'vide' : '');
        if (colonne.vente && valeur != null && valeur > 0) cellule.classList.add('vente');
        ligne.append(cellule);
      }
      if (avecNotes) ligne.append(celluleNote(jour.date, d));
      corps.append(ligne);
    }

    const pied = creer('tfoot');
    const ligneTotal = creer('tr');
    ligneTotal.append(creer('td', 'TOTAL'));
    const calculesTotal = indicateurs(total);
    for (const colonne of colonnes) ligneTotal.append(creer('td', ecrire(colonne.lire?.(total, calculesTotal) ?? null, colonne.format)));
    if (avecNotes) ligneTotal.append(creer('td', ''));
    pied.append(ligneTotal);

    table.replaceChildren(tete, corps, pied);
  }

  /** Une note par jour (« scaling cbo », « nouvelles pubs »…), modifiable d'un clic. */
  function celluleNote(date: string, d: Donnees) {
    const cellule = creer('td', '', 'note');
    const bouton = creer('button', d.notes[date] ?? '');
    bouton.type = 'button';
    bouton.setAttribute('aria-label', `Note du ${libelleJour(date)} : ${d.notes[date] ?? 'aucune'}. Modifier`);
    bouton.addEventListener('click', () => {
      const champ = creer('input');
      champ.type = 'text';
      champ.maxLength = 160;
      champ.value = d.notes[date] ?? '';
      champ.setAttribute('aria-label', `Note du ${libelleJour(date)}`);
      let termine = false;
      const terminer = async (enregistrer: boolean) => {
        if (termine) return;
        termine = true;
        const note = champ.value.trim();
        if (enregistrer && note !== (d.notes[date] ?? '')) {
          const resultat = await appeler('/note', { method: 'POST', body: JSON.stringify({ date, note }) });
          if (resultat.statut === 200) {
            if (note) d.notes[date] = String(resultat.corps?.note ?? note);
            else delete d.notes[date];
          } else {
            signaler(
              resultat.corps?.erreur === 'a-brancher'
                ? 'La note n’est pas enregistrée : la base des compteurs n’est pas encore reliée.'
                : 'La note n’a pas pu être enregistrée. Réessaie dans un instant.',
            );
          }
        }
        cellule.replaceWith(celluleNote(date, d));
      };
      champ.addEventListener('keydown', (evenement) => {
        if (evenement.key === 'Enter') void terminer(true);
        if (evenement.key === 'Escape') void terminer(false);
      });
      champ.addEventListener('blur', () => void terminer(true));
      cellule.replaceChildren(champ);
      champ.focus();
    });
    cellule.append(bouton);
    return cellule;
  }

  function afficherFormulations(d: Donnees) {
    const bloc = $('[data-formulations]');
    const table = $('[data-table="formulations"]');
    if (!bloc || !table) return;
    bloc.hidden = d.variantes.length === 0;
    if (d.variantes.length === 0) return;
    const tete = creer('thead');
    const enTete = creer('tr');
    for (const [titre, aide] of [
      ['Formulation', 'Adresse de la formulation : /inscription/…'],
      ['Vues', 'Affichages de la landing (hors robots)'],
      ['Inscrits', 'Formulaires envoyés'],
      ['% Inscription', 'Inscrits ÷ vues'],
    ]) {
      const cellule = creer('th', titre);
      cellule.title = aide ?? '';
      enTete.append(cellule);
    }
    tete.append(enTete);
    const corps = creer('tbody');
    for (const variante of d.variantes) {
      const ligne = creer('tr');
      ligne.append(creer('td', variante.nom));
      ligne.append(creer('td', ecrire(variante.vues, 'entier')));
      ligne.append(creer('td', ecrire(variante.inscrits, 'entier')));
      ligne.append(creer('td', ecrire(variante.vues > 0 ? variante.inscrits / variante.vues : null, 'pourcent')));
      corps.append(ligne);
    }
    table.replaceChildren(tete, corps);
  }

  /* ---------- Les ventes : liste, commissions, encaissements, closers ---------- */

  const FORMAT_EXACT = nombre({ style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 });
  /** Un montant : sans centimes quand il tombe juste. */
  const argent = (valeur: number) => (Number.isInteger(valeur) ? FORMATS.euros : FORMAT_EXACT).format(valeur);
  const libelleDate = (date: string) => `${date.slice(8)}/${date.slice(5, 7)}/${date.slice(0, 4)}`;
  const nomMethode = (id: string) => (METHODES as Record<string, { nom: string }>)[id]?.nom ?? id;
  const nomFormule = (id: string) => (FORMULES as Record<string, string>)[id] ?? id;

  /** « GoCardless 1 000 € + seQura 2 000 € en 6 fois ». */
  const resumePaiements = (vente: Vente) =>
    vente.paiements
      .map((paiement) => `${nomMethode(paiement.methode)} ${argent(paiement.montant)}${paiement.mensualites > 1 ? ` en ${paiement.mensualites} fois` : ''}`)
      .join(' + ');

  /** Remplit une table simple : ses titres, ses lignes, et sa ligne de total s'il y en a une. */
  function remplirTable(nom: string, titres: [string, string][], lignes: { cellules: (string | HTMLElement)[]; classe?: string }[], total?: string[]) {
    const table = $(`[data-table="${nom}"]`);
    if (!table) return;
    const enTete = creer('tr');
    for (const [titre, aide] of titres) {
      const cellule = creer('th', titre);
      if (aide) cellule.title = aide;
      cellule.scope = 'col';
      enTete.append(cellule);
    }
    const tete = creer('thead');
    tete.append(enTete);
    const corps = creer('tbody');
    for (const { cellules, classe } of lignes) {
      const ligne = creer('tr', '', classe ?? '');
      for (const contenu of cellules) {
        const cellule = creer('td');
        if (typeof contenu === 'string') cellule.textContent = contenu;
        else cellule.append(contenu);
        ligne.append(cellule);
      }
      corps.append(ligne);
    }
    const parties: HTMLElement[] = [tete, corps];
    if (total) {
      const pied = creer('tfoot');
      const ligne = creer('tr');
      for (const contenu of total) ligne.append(creer('td', contenu));
      pied.append(ligne);
      parties.push(pied);
    }
    table.replaceChildren(...parties);
  }

  /** Ce qu'une vente a déclenché, en clair. « fait » : en vert ; « rate » : en rouge, à relancer. */
  function suiviDeVente(vente: Vente, enLigne: boolean): { texte: string; classe: string; relance: boolean }[] {
    const suivi = vente.suivi ?? {};
    const lignes: { texte: string; classe: string; relance: boolean }[] = [];
    const ac: Record<string, [string, string, boolean]> = {
      ok: ['Liste Client ✓', 'fait', false],
      erreur: ['Liste Client : pas passée', 'rate', true],
      simulation: [enLigne ? 'Liste Client : à envoyer' : 'Liste Client : à la mise en production', '', enLigne],
      'a-brancher': ['Liste Client : ActiveCampaign à brancher', '', false],
    };
    const meta: Record<string, [string, string, boolean]> = {
      ok: ['Achat envoyé à Meta ✓', 'fait', false],
      erreur: ['Achat : refusé par Meta', 'rate', true],
      simulation: [enLigne ? 'Achat : à envoyer à Meta' : 'Achat Meta : à la mise en production', '', enLigne],
      'sans-accord': ['Achat non envoyé à Meta (sans accord)', '', false],
      'trop-ancienne': ['Achat non envoyé à Meta (vente de plus de 6 jours)', '', false],
    };
    for (const etat of [ac[suivi.ac ?? ''], meta[suivi.meta ?? '']]) {
      if (etat) lignes.push({ texte: etat[0], classe: etat[1], relance: etat[2] });
    }
    return lignes;
  }

  /** La cellule « Élève » d'une vente : son email, ce que la vente a déclenché, et la relance s'il le faut. */
  function celluleEleve(vente: Vente, d: Donnees) {
    const cellule = creer('span');
    if (!vente.email) {
      cellule.append(creer('span', 'Email non renseigné', 'suivi-vente'));
      return cellule;
    }
    cellule.append(creer('span', vente.email));
    const lignes = suiviDeVente(vente, d.suivi?.tunnel?.etat === 'ok');
    for (const ligne of lignes) cellule.append(creer('span', ligne.texte, `suivi-vente ${ligne.classe}`.trim()));
    if (lignes.some((ligne) => ligne.relance)) {
      const relancer = creer('button', 'Relancer', 'lien');
      relancer.type = 'button';
      relancer.dataset.relancerVente = vente.id;
      relancer.addEventListener('click', async () => {
        relancer.disabled = true;
        relancer.textContent = 'Envoi…';
        const resultat = await appeler('/vente', { method: 'POST', body: JSON.stringify({ mois, renvoyer: vente.id }) });
        if (resultat.statut === 200 && resultat.corps?.ok) appliquerVentes(resultat.corps as BlocVentes);
        else {
          relancer.disabled = false;
          relancer.textContent = 'Relancer';
          signaler('La relance n’a pas abouti. Réessaie dans un instant.');
        }
      });
      cellule.append(relancer);
    }
    return cellule;
  }

  function afficherVentes(d: Donnees) {
    // Sans la base, rien ne peut s'enregistrer : la carte « Ventes » dit quoi relier.
    const pret = d.sources.ventes?.etat === 'ok';
    const ajouter = $('[data-ajouter-vente]');
    if (ajouter) ajouter.hidden = !pret;
    for (const nom of ['ventes', 'commissions', 'encaissements', 'closers']) {
      const bloc = $(`[data-bloc-${nom}]`);
      if (bloc) bloc.hidden = !pret;
    }
    if (!pret) return;

    // Les ventes du mois : un clic sur « Modifier » rouvre la vente.
    const aucune = $('[data-aucune-vente]');
    const cadre = $('[data-cadre-ventes]');
    if (aucune) aucune.hidden = d.ventes.length > 0;
    if (cadre) cadre.hidden = d.ventes.length === 0;
    const somme = (cle: 'montant' | 'commission' | 'encaisse' | 'reste') => d.ventes.reduce((total, vente) => total + vente[cle], 0);
    remplirTable(
      'ventes',
      [
        ['Jour', ''],
        ['Formule', ''],
        ['Montant', 'Montant de la vente'],
        ['Closer', ''],
        ['Commission', 'Commission du closer'],
        ['Paiement', 'Moyens de paiement de la vente'],
        ['Encaissé', 'Déjà encaissé, d’après l’échéancier'],
        ['Reste', 'Reste à encaisser'],
        ['Élève', 'Son email, et ce que la vente a déclenché : liste « Client » d’ActiveCampaign, événement « Achat » chez Meta'],
        ['', ''],
      ],
      d.ventes.map((vente) => {
        const modifier = creer('button', 'Modifier', 'lien');
        modifier.type = 'button';
        modifier.dataset.modifierVente = vente.id;
        modifier.setAttribute('aria-label', `Modifier la vente du ${libelleJour(vente.date)}, ${argent(vente.montant)}`);
        modifier.addEventListener('click', () => ouvrirVente(vente));
        const paiement = creer('span', resumePaiements(vente) + (vente.note ? ` · ${vente.note}` : ''));
        return {
          cellules: [
            libelleJour(vente.date),
            nomFormule(vente.formule),
            argent(vente.montant),
            d.closers.find((closer) => closer.id === vente.closer)?.nom ?? vente.closerNom,
            argent(vente.commission),
            paiement,
            argent(vente.encaisse),
            argent(vente.reste),
            celluleEleve(vente, d),
            modifier,
          ],
        };
      }),
      d.ventes.length > 1 ? ['TOTAL', `${d.ventes.length} ventes`, argent(somme('montant')), '', argent(somme('commission')), '', argent(somme('encaisse')), argent(somme('reste')), '', ''] : undefined,
    );
    // Formule, closer, paiement et élève sont du texte : alignés à gauche, titres compris.
    for (const cellule of document.querySelectorAll<HTMLElement>('[data-table="ventes"] tr > :is(:nth-child(2), :nth-child(4), :nth-child(6), :nth-child(9))')) {
      cellule.classList.add('texte');
    }

    // Les commissions du mois, par closer.
    const blocCommissions = $('[data-bloc-commissions]');
    if (blocCommissions) blocCommissions.hidden = d.commissions.length === 0;
    remplirTable(
      'commissions',
      [
        ['Closer', ''],
        ['Ventes', 'Ventes du mois'],
        ['Commandé', 'Montant de ses ventes du mois'],
        ['Commissions', 'Total de ses commissions du mois'],
      ],
      d.commissions.map((ligne) => ({
        cellules: [d.closers.find((closer) => closer.id === ligne.closer)?.nom ?? ligne.nom, ecrire(ligne.ventes, 'entier'), argent(ligne.contracte), argent(ligne.commission)],
      })),
      d.commissions.length > 1
        ? [
            'TOTAL',
            ecrire(d.commissions.reduce((total, ligne) => total + ligne.ventes, 0), 'entier'),
            argent(d.commissions.reduce((total, ligne) => total + ligne.contracte, 0)),
            argent(d.commissions.reduce((total, ligne) => total + ligne.commission, 0)),
          ]
        : undefined,
    );

    // Le MRR : ce qui doit être encaissé, le mois affiché et les onze suivants.
    const duMois = d.encaissements[0];
    const suivant = d.encaissements[1];
    const cartes = $('[data-cartes="encaissements"]');
    if (cartes && duMois) {
      const carte = (libelle: string, valeur: string, precision: string) => {
        const element = creer('li');
        element.append(creer('span', libelle, 'libelle'), creer('span', valeur, 'valeur'), creer('span', precision, 'precision'));
        return element;
      };
      cartes.replaceChildren(
        carte(`Encaissements ${deMois(d.mois)}`, argent(duMois.total), `Dont déjà encaissé : ${argent(duMois.encaisse)}`),
        carte(`MRR ${deMois(suivant?.mois ?? d.mois)}`, argent(suivant?.total ?? 0), 'Ce qui doit être encaissé le mois suivant'),
        carte('Reste à encaisser', argent(d.aEncaisser), 'Toutes ventes confondues, après aujourd’hui'),
      );
    }
    const methodes = Object.keys(METHODES);
    remplirTable(
      'encaissements',
      [['Mois', ''], ...methodes.map((id): [string, string] => [nomMethode(id), '']), ['Total', 'Tout ce qui est encaissé ce mois-là (MRR)']],
      d.encaissements.map((ligne) => ({
        cellules: [libelleMois(ligne.mois), ...methodes.map((id) => argent(ligne.parMethode[id] ?? 0)), argent(ligne.total)],
        classe: ligne.mois === d.aujourdHui.slice(0, 7) ? 'en-cours' : '',
      })),
    );

    // Les closers enregistrés : ils se choisissent dans la liste de la vente.
    const blocClosers = $('[data-bloc-closers]');
    const listeClosers = $('[data-closers]');
    if (blocClosers) blocClosers.hidden = d.closers.length === 0;
    listeClosers?.replaceChildren(
      ...d.closers.map((closer) => {
        const element = creer('li', closer.nom);
        const retirer = creer('button', 'Retirer');
        retirer.type = 'button';
        retirer.setAttribute('aria-label', `Retirer ${closer.nom} de la liste des closers`);
        retirer.addEventListener('click', async () => {
          // Un premier clic demande confirmation, le second retire.
          if (!retirer.dataset.confirme) {
            retirer.dataset.confirme = 'oui';
            retirer.textContent = 'Confirmer';
            return;
          }
          const resultat = await appeler(`/closer?id=${encodeURIComponent(closer.id)}`, { method: 'DELETE' });
          if (resultat.statut === 200 && Array.isArray(resultat.corps?.closers)) {
            d.closers = resultat.corps.closers;
            afficherVentes(d);
          } else {
            signaler('Le closer n’a pas pu être retiré. Réessaie dans un instant.');
          }
        });
        element.append(retirer);
        return element;
      }),
    );
  }

  /** Reporte dans la page ce que le serveur rend après un changement dans les ventes. */
  function appliquerVentes(bloc: BlocVentes) {
    const d = donnees;
    if (!d) return;
    for (const jour of d.jours) {
      if (jour.date > d.aujourdHui) continue;
      Object.assign(jour, bloc.jours[jour.date] ?? { ventes: 0, contracte: 0, encaisse: 0 });
    }
    Object.assign(d, { ventes: bloc.ventes, closers: bloc.closers, encaissements: bloc.encaissements, aEncaisser: bloc.aEncaisser, commissions: bloc.commissions });
    afficher(d);
    // Une vente ajoutée, modifiée ou supprimée change aussi le rapport des publicités.
    void chargerPubs();
  }

  function afficher(d: Donnees) {
    donnees = d;
    const total = totaliser(d.jours);
    const demonstration = $('[data-demonstration]');
    if (demonstration) demonstration.hidden = !d.demonstration;
    afficherSources(d.sources, d.campagnes);
    afficherSuivi(d.suivi);
    for (const partie of Object.keys(COLONNES)) {
      afficherCartes(partie, total);
      afficherTable(partie, d, total);
    }
    afficherFormulations(d);
    afficherVentes(d);
  }

  /* ---------- Les publicités : créations, verdicts, moments ---------- */

  const choixPeriode = $<HTMLSelectElement>('[data-pubs-periode]');
  const choixSource = $<HTMLSelectElement>('[data-pubs-source]');
  const etatPubs = $('[data-pubs-etat]');
  const contenuPubs = $('[data-pubs-contenu]');
  const boutonRapport = $<HTMLButtonElement>('[data-copier-rapport]');
  let rapportPubs: RapportPubs | null = null;
  /** Vrai dès que la source des résultats a été choisie à la main. */
  let sourceChoisie = false;
  /** Numéro de la dernière demande : une réponse arrivée trop tard est ignorée. */
  let demandePubs = 0;
  /** Créations dont le détail est ouvert. */
  const pubsOuvertes = new Set<string>();

  const JOURS_SEMAINE = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
  const STATUTS_PUB: Record<string, string> = {
    ACTIVE: 'Active',
    PAUSED: 'En pause',
    ADSET_PAUSED: 'Ensemble en pause',
    CAMPAIGN_PAUSED: 'Campagne en pause',
    ARCHIVED: 'Archivée',
    DELETED: 'Supprimée',
    DISAPPROVED: 'Refusée',
    PENDING_REVIEW: 'En examen',
    WITH_ISSUES: 'En erreur',
    IN_PROCESS: 'En préparation',
  };
  const NOMS_SOURCE: Record<SourcePub, string> = {
    tunnel: 'le tunnel (inscrites de la landing, rendez-vous d’iClosed, ventes du cockpit)',
    meta: 'Meta (pixel et API de conversion)',
  };
  const NIVEAUX = { ventes: 'les ventes', rdv: 'les rendez-vous', inscrites: 'les inscrites' };
  const AUCUN_RESULTAT: ResultatsTunnel = { inscrites: 0, rdv: 0, rdvAnnules: 0, ventes: 0, commande: 0, encaisse: 0 };

  const sourcePubs = (): SourcePub => (choixSource?.value === 'meta' ? 'meta' : 'tunnel');
  const pluriel = (nombre: number, mot: string, mots = `${mot}s`) => `${ecrire(nombre, 'entier')} ${nombre > 1 ? mots : mot}`;

  /** Une cellule de tableau, avec son texte, sa classe et son infobulle éventuelle. */
  function cellule(contenu: string | HTMLElement, classe = '', aide = '') {
    const td = creer('td', '', classe);
    if (typeof contenu === 'string') td.textContent = contenu;
    else td.append(contenu);
    if (aide) td.title = aide;
    return td;
  }

  /** L'en-tête d'un tableau : [titre, infobulle] par colonne. */
  function enTeteDeTable(titres: [string, string][]) {
    const ligne = creer('tr');
    for (const [titre, aide] of titres) {
      const th = creer('th', titre);
      if (aide) th.title = aide;
      th.scope = 'col';
      ligne.append(th);
    }
    const tete = creer('thead');
    tete.append(ligne);
    return tete;
  }

  /** « 50 inscrites à 6,0 € · 5 rendez-vous à 60 € · 1 vente (3 000 €) · ROAS 10,0 » */
  function resumeResultats(ligne: { depense: number; impressions: number; clics: number; vues3s: number; vuesCompletes: number }, r: { inscrites: number; rdv: number; ventes: number; commande: number }) {
    const i = indicateursPub(ligne, r);
    const morceaux = [`dépense ${ecrire(ligne.depense, 'euros')}`];
    if (i.ctr != null) morceaux.push(`CTR ${ecrire(i.ctr, 'pourcent')}`);
    if (i.accroche != null) morceaux.push(`accroche ${ecrire(i.accroche, 'pourcent')}`);
    morceaux.push(r.inscrites > 0 ? `${pluriel(r.inscrites, 'inscrite')} à ${ecrire(i.coutInscrite, 'centimes')}` : 'aucune inscrite');
    morceaux.push(r.rdv > 0 ? `${ecrire(r.rdv, 'entier')} rendez-vous à ${ecrire(i.coutRdv, 'euros')}` : 'aucun rendez-vous');
    if (r.ventes > 0) morceaux.push(`${pluriel(r.ventes, 'vente')} (${ecrire(r.commande, 'euros')})`, `ROAS ${ecrire(i.roas, 'ratio')}`);
    return morceaux.join(' · ');
  }

  /** Pourquoi ce verdict : la création face à la moyenne de la période. */
  function raisonDuVerdict(ligne: LignePub, source: SourcePub, base: string, reperes: ReturnType<typeof classerPubs>['reperes']) {
    const r = resultats(ligne, source);
    const i = indicateursPub(ligne, r);
    if (base === 'ventes') return `Jugée sur les ventes : ROAS ${ecrire(i.roas, 'ratio')} (moyenne : ${ecrire(reperes.roas, 'ratio')})`;
    if (base === 'rdv') return `Jugée sur les rendez-vous : ${ecrire(r.rdv, 'entier')} à ${ecrire(i.coutRdv, 'euros')} (moyenne : ${ecrire(reperes.coutRdv, 'euros')})`;
    if (base === 'inscrites') return `Jugée sur les inscrites : ${ecrire(r.inscrites, 'entier')} à ${ecrire(i.coutInscrite, 'centimes')} (moyenne : ${ecrire(reperes.coutInscrite, 'centimes')})`;
    return '';
  }

  /** Le détail d'une création : son texte, son état, et ses résultats selon les deux sources. */
  function detailDePub(ligne: LignePub, colonnes: number) {
    const rangee = creer('tr', '', 'detail-pub');
    const td = creer('td');
    td.colSpan = colonnes;
    const faits = creer('ul', '', 'faits');
    const fait = (texte: string) => faits.append(creer('li', texte));
    if (ligne.statut) fait(`État : ${STATUTS_PUB[ligne.statut] ?? ligne.statut}`);
    if (ligne.creeLe) fait(`Créée le ${libelleDate(ligne.creeLe)}`);
    if (ligne.ensembles > 0) fait(`Diffusée dans ${pluriel(ligne.ensembles, 'ensemble')}`);
    if (ligne.campagnes.length > 0) fait(`${ligne.campagnes.length > 1 ? 'Campagnes' : 'Campagne'} : ${ligne.campagnes.join(', ')}`);
    fait(`Selon Meta : ${pluriel(ligne.meta.prospects, 'prospect')}, ${ecrire(ligne.meta.rdv, 'entier')} rendez-vous, ${pluriel(ligne.meta.achats, 'achat')}`);
    fait(
      `Selon le tunnel : ${pluriel(ligne.tunnel.inscrites, 'inscrite')}, ${ecrire(ligne.tunnel.rdv, 'entier')} rendez-vous${ligne.tunnel.rdvAnnules > 0 ? ` (+ ${pluriel(ligne.tunnel.rdvAnnules, 'annulé')})` : ''}, ${pluriel(ligne.tunnel.ventes, 'vente')}${ligne.tunnel.ventes > 0 ? ` (${argent(ligne.tunnel.commande)} commandés, ${argent(ligne.tunnel.encaisse)} encaissés)` : ''}`,
    );
    if (ligne.vuesCompletes > 0 && ligne.vues3s > 0) fait(`Rétention : ${ecrire(ligne.vuesCompletes / ligne.vues3s, 'pourcent')} des lectures de 3 s vont au bout (ou à 15 s)`);
    td.append(faits);
    if (ligne.titre) td.append(creer('p', ligne.titre, 'texte-pub titre-pub'));
    td.append(creer('p', ligne.texte || 'Texte de la publicité non disponible.', 'texte-pub'));
    rangee.append(td);
    return rangee;
  }

  function afficherPubs() {
    const r = rapportPubs;
    if (!r || !etatPubs || !contenuPubs) return;
    const sansPub = r.sansPub ?? AUCUN_RESULTAT;
    const parle = tunnelParle(r.pubs, sansPub);
    // Tant que le tunnel n'a rien vu sur la période, seuls les chiffres de Meta parlent.
    if (!sourceChoisie && choixSource) choixSource.value = parle ? 'tunnel' : 'meta';
    const source = sourcePubs();

    const messages: string[] = [];
    if (r.etats.meta === 'a-brancher') messages.push('Meta Ads n’est pas branché : la dépense et les créations ne peuvent pas s’afficher.');
    if (r.etats.meta === 'erreur') messages.push(`Meta Ads : ${r.details.meta || 'erreur'}.`);
    if (r.etats.iclosed === 'erreur') messages.push(`iClosed : ${r.details.iclosed || 'erreur'}.`);
    if (r.etats.meta === 'ok' && !r.pubs.some((ligne) => ligne.depense > 0)) {
      messages.push(`Aucune publicité diffusée sur la période${r.campagnes ? ` dans les campagnes dont le nom contient « ${r.campagnes} »` : ''}.`);
    }
    etatPubs.textContent = messages.join(' ');
    etatPubs.hidden = messages.length === 0;
    etatPubs.classList.toggle('erreur', r.etats.meta === 'erreur' || r.etats.iclosed === 'erreur');
    contenuPubs.hidden = false;
    if (boutonRapport) boutonRapport.disabled = r.pubs.length === 0;

    const legende = $('[data-pubs-legende]');
    if (legende) {
      legende.textContent =
        `Du ${libelleDate(r.du)} au ${libelleDate(r.au)}${r.campagnes ? ` · campagnes dont le nom contient « ${r.campagnes} »` : ''} · résultats comptés par ${NOMS_SOURCE[source]}.` +
        (source === 'tunnel' && !parle ? ' Le nouveau tunnel n’a pas vu d’inscrite sur cette période : il compte à partir de sa mise en production.' : '') +
        (source === 'meta' && !parle ? ' Le nouveau tunnel n’a pas vu d’inscrite sur cette période : ce sont les chiffres de Meta.' : '') +
        (source === 'meta' && sansPub.rdv + sansPub.ventes > 0
          ? ` À côté, sans publicité connue : ${ecrire(sansPub.rdv, 'entier')} rendez-vous dans iClosed, ${pluriel(sansPub.ventes, 'vente')} dans le cockpit.`
          : '');
    }

    const { niveau, reperes, verdicts } = classerPubs(r.pubs, source);
    const total = totaliserPubs(r.pubs, source);
    // Pour le tunnel, les cartes comptent aussi les inscrites sans publicité connue : le coût par inscrite reste juste.
    const ensemble =
      source === 'tunnel'
        ? { ...total, inscrites: total.inscrites + sansPub.inscrites, rdv: total.rdv + sansPub.rdv, ventes: total.ventes + sansPub.ventes, commande: total.commande + sansPub.commande }
        : total;
    const indic = indicateursPub(total, ensemble);

    const cartes = $('[data-cartes="publicites"]');
    if (cartes) {
      const carte = (libelle: string, valeur: string, precision: string) => {
        const element = creer('li');
        element.append(creer('span', libelle, 'libelle'), creer('span', valeur, 'valeur'), creer('span', precision, 'precision'));
        return element;
      };
      const gagnantes = r.pubs.filter((ligne) => verdicts[ligne.cle]?.verdict === 'gagnante').length;
      cartes.replaceChildren(
        carte('Créations', ecrire(r.pubs.filter((ligne) => ligne.depense > 0).length, 'entier'), gagnantes > 0 ? `dont ${pluriel(gagnantes, 'gagnante')}` : 'aucune gagnante pour l’instant'),
        carte('Dépense', ecrire(total.depense, 'euros'), 'Sur la période'),
        carte('Inscrites', ecrire(ensemble.inscrites, 'entier'), `Coût par inscrite : ${ecrire(indic.coutInscrite, 'centimes')}`),
        carte('Rendez-vous', ecrire(ensemble.rdv, 'entier'), `Coût par rendez-vous : ${ecrire(indic.coutRdv, 'euros')}`),
        carte('Ventes', ecrire(ensemble.ventes, 'entier'), `Commandé : ${ecrire(ensemble.commande, 'euros')}`),
        // Sans vente, pas de ROAS : un tiret, jamais un zéro trompeur.
        carte('ROAS', ensemble.ventes > 0 ? ecrire(indic.roas, 'ratio') : '—', 'Commandé ÷ dépense'),
      );
    }

    // Le tableau des créations : les gagnantes d'abord.
    const table = $('[data-table="publicites"]');
    const titres: [string, string][] = [
      ['Création', 'Nom de la publicité (toutes ses diffusions réunies). Un clic montre son texte.'],
      ['Verdict', 'Par rapport à la moyenne de la période'],
      ['Dépense', ''],
      ['Imp.', 'Impressions'],
      ['CTR', 'Clics sur le lien ÷ impressions'],
      ['Accroche', 'Lectures de la vidéo de 3 secondes ÷ impressions'],
      ['Inscrites', source === 'meta' ? 'Événements « Prospect » attribués par Meta' : 'Inscrites de la landing arrivées par cette publicité'],
      ['Coût insc.', 'Dépense ÷ inscrites'],
      ['RDV', source === 'meta' ? 'Événements « Rendez-vous programmé » attribués par Meta' : 'Appels réservés dans iClosed (hors annulés) par des inscrites venues de cette publicité'],
      ['Coût RDV', 'Dépense ÷ rendez-vous'],
      ['Ventes', source === 'meta' ? 'Événements « Achat » attribués par Meta' : 'Ventes du cockpit rattachées à cette publicité par l’email de l’élève'],
      ['Commandé', 'Montant des ventes'],
      ['ROAS', 'Commandé ÷ dépense'],
    ];
    if (table) {
      const corps = creer('tbody');
      const rangee = (nom: string | HTMLElement, verdict: string | HTMLElement, chiffres: { depense: number; impressions: number; clics: number; vues3s: number; vuesCompletes: number }, res: { inscrites: number; rdv: number; ventes: number; commande: number }, classe = '') => {
        const i = indicateursPub(chiffres, res);
        const tr = creer('tr', '', classe);
        tr.append(
          cellule(nom, 'creation'),
          cellule(verdict, 'texte'),
          cellule(chiffres.depense > 0 ? ecrire(chiffres.depense, 'euros') : '—'),
          cellule(chiffres.impressions > 0 ? ecrire(chiffres.impressions, 'entier') : '—'),
          cellule(ecrire(i.ctr, 'pourcent')),
          cellule(ecrire(i.accroche, 'pourcent')),
          cellule(ecrire(res.inscrites, 'entier')),
          // Sans dépense, pas de coût : un tiret, jamais un zéro trompeur.
          cellule(chiffres.depense > 0 ? ecrire(i.coutInscrite, 'centimes') : '—'),
          cellule(ecrire(res.rdv, 'entier')),
          cellule(chiffres.depense > 0 ? ecrire(i.coutRdv, 'euros') : '—'),
          cellule(ecrire(res.ventes, 'entier'), res.ventes > 0 ? 'vente' : ''),
          cellule(res.commande > 0 ? ecrire(res.commande, 'euros') : '—'),
          cellule(chiffres.depense > 0 && res.ventes > 0 ? ecrire(i.roas, 'ratio') : '—'),
        );
        return tr;
      };
      for (const ligne of trierPubs(r.pubs, verdicts)) {
        const ouvrir = creer('button', '', 'ouvrir-pub');
        ouvrir.type = 'button';
        ouvrir.dataset.pub = ligne.cle;
        ouvrir.setAttribute('aria-expanded', String(pubsOuvertes.has(ligne.cle)));
        if (ligne.vignette) {
          const image = creer('img');
          image.src = ligne.vignette;
          image.alt = '';
          image.loading = 'lazy';
          image.referrerPolicy = 'no-referrer';
          ouvrir.append(image);
        }
        ouvrir.append(creer('span', ligne.nom));
        ouvrir.addEventListener('click', () => {
          if (pubsOuvertes.has(ligne.cle)) pubsOuvertes.delete(ligne.cle);
          else pubsOuvertes.add(ligne.cle);
          afficherPubs();
        });
        const { verdict, base } = verdicts[ligne.cle] ?? { verdict: '', base: '' };
        const pastille = verdict ? creer('span', (VERDICTS as Record<string, string>)[verdict] ?? '', `verdict ${verdict}`) : creer('span', 'Pas de dépense sur la période', 'suivi-vente');
        if (verdict) pastille.title = raisonDuVerdict(ligne, source, base, reperes);
        corps.append(rangee(ouvrir, pastille, ligne, resultats(ligne, source), ligne.depense > 0 ? '' : 'sans-depense'));
        if (pubsOuvertes.has(ligne.cle)) corps.append(detailDePub(ligne, titres.length));
      }
      if (source === 'tunnel' && sansPub.inscrites + sansPub.rdv + sansPub.ventes > 0) {
        const vide = { depense: 0, impressions: 0, clics: 0, vues3s: 0, vuesCompletes: 0 };
        corps.append(rangee('Sans publicité connue', creer('span', 'Lien sans paramètres, email, accès direct', 'suivi-vente'), vide, sansPub, 'sans-pub'));
      }
      const pied = creer('tfoot');
      const ligneTotal = rangee('TOTAL', '', total, ensemble);
      pied.append(ligneTotal);
      table.replaceChildren(enTeteDeTable(titres), corps, pied);
      for (const element of table.querySelectorAll<HTMLElement>('tr > :nth-child(2)')) element.classList.add('texte');
    }

    const regle = $('[data-pubs-regle]');
    if (regle) {
      regle.textContent = `Verdict : chaque création est comparée à la moyenne de la période, sur ${NIVEAUX[niveau]} (le niveau le plus profond qui compte assez de résultats). Gagnante : au moins 20 % moins chère que la moyenne, avec assez de résultats. À couper : deux fois le coût moyen dépensé sans résultat, ou 50 % plus chère. Prometteuse : bonne en amont, pas encore confirmée plus bas.`;
    }

    afficherMoments(r, source);
    const parametres = $('[data-pubs-parametres]');
    if (parametres) parametres.textContent = r.parametres;
  }

  /** À quel moment : par jour de la semaine, par heure, et combien de temps après l'inscription. */
  function afficherMoments(r: RapportPubs, source: SourcePub) {
    const cleInscrites = source === 'meta' ? 'prospects' : 'inscrites';
    /** Met en avant la cellule la plus haute d'une colonne (à partir de la deuxième ligne de données s'il y en a). */
    const marquerLeMeilleur = (table: HTMLElement, colonne: number) => {
      let meilleur: HTMLElement | null = null;
      let record = 0;
      for (const td of table.querySelectorAll<HTMLElement>(`tbody tr > :nth-child(${colonne})`)) {
        const valeur = Number(td.dataset.valeur ?? 0);
        if (valeur > record) {
          record = valeur;
          meilleur = td;
        }
      }
      meilleur?.classList.add('meilleur');
    };
    const chiffre = (valeur: number, format: Format) => {
      const td = cellule(ecrire(valeur, format));
      td.dataset.valeur = String(valeur);
      return td;
    };

    const semaine = $('[data-table="semaine"]');
    if (semaine) {
      const corps = creer('tbody');
      for (const ligne of parJourDeSemaine(r.jours, ['depense', 'prospects', 'inscrites', 'rdv', 'ventes'])) {
        const inscrites = ligne[cleInscrites] ?? 0;
        const tr = creer('tr');
        tr.append(
          cellule(JOURS_SEMAINE[ligne.jour ?? 0] ?? ''),
          cellule(ecrire(ligne.depense ?? 0, 'euros')),
          chiffre(inscrites, 'entier'),
          cellule(inscrites > 0 ? ecrire((ligne.depense ?? 0) / inscrites, 'centimes') : '—'),
          chiffre(ligne.rdv ?? 0, 'entier'),
          chiffre(ligne.ventes ?? 0, 'entier'),
        );
        corps.append(tr);
      }
      semaine.replaceChildren(
        enTeteDeTable([
          ['Jour', ''],
          ['Dépense', ''],
          ['Inscrites', source === 'meta' ? 'Prospects attribués par Meta' : 'Inscrites de la landing'],
          ['Coût insc.', 'Dépense ÷ inscrites'],
          ['RDV', 'Appels réservés ce jour-là (iClosed)'],
          ['Ventes', 'Ventes enregistrées ce jour-là'],
        ]),
        corps,
      );
      marquerLeMeilleur(semaine, 3);
      marquerLeMeilleur(semaine, 5);
    }

    const heures = $('[data-table="heures"]');
    if (heures) {
      const corps = creer('tbody');
      for (const ligne of r.heures) {
        const inscrites = ligne[cleInscrites];
        if (ligne.depense === 0 && ligne.clics === 0 && inscrites === 0) continue;
        const tr = creer('tr');
        tr.append(
          cellule(`${ligne.heure} h`),
          cellule(ecrire(ligne.depense, 'euros')),
          cellule(ecrire(ligne.clics, 'entier')),
          chiffre(inscrites, 'entier'),
          cellule(inscrites > 0 && ligne.depense > 0 ? ecrire(ligne.depense / inscrites, 'centimes') : '—'),
        );
        corps.append(tr);
      }
      if (!corps.firstChild) {
        const tr = creer('tr');
        const td = cellule('Aucune activité sur la période.', 'texte');
        td.colSpan = 5;
        tr.append(td);
        corps.append(tr);
      }
      heures.replaceChildren(
        enTeteDeTable([
          ['Heure', 'Heure de Paris'],
          ['Dépense', ''],
          ['Clics', 'Clics sur le lien'],
          ['Inscrites', source === 'meta' ? 'Prospects attribués par Meta, à l’heure de la publicité' : 'Inscrites de la landing, à l’heure de leur inscription'],
          ['Coût insc.', 'Dépense ÷ inscrites'],
        ]),
        corps,
      );
      marquerLeMeilleur(heures, 4);
    }

    const delais = $('[data-table="delais"]');
    if (delais) {
      const corps = creer('tbody');
      for (const tranche of r.delais.tranches) {
        const tr = creer('tr');
        tr.append(cellule(tranche.nom), chiffre(r.delais.rdv[tranche.cle] ?? 0, 'entier'), chiffre(r.delais.vente[tranche.cle] ?? 0, 'entier'));
        corps.append(tr);
      }
      delais.replaceChildren(
        enTeteDeTable([
          ['Après l’inscription', ''],
          ['RDV pris', 'Rendez-vous réservés dans ce délai'],
          ['Ventes', 'Ventes conclues dans ce délai'],
        ]),
        corps,
      );
      marquerLeMeilleur(delais, 2);
    }
  }

  /** Le rapport en texte, à coller dans une conversation pour écrire les prochaines publicités. */
  function texteDuRapport() {
    const r = rapportPubs;
    if (!r) return '';
    const source = sourcePubs();
    const sansPub = r.sansPub ?? AUCUN_RESULTAT;
    const { niveau, verdicts } = classerPubs(r.pubs, source);
    const total = totaliserPubs(r.pubs, source);
    const sorties = [
      'RAPPORT DES PUBLICITÉS · Académie Florale (tunnel VSL)',
      `Période : du ${libelleDate(r.du)} au ${libelleDate(r.au)}${r.campagnes ? `, campagnes dont le nom contient « ${r.campagnes} »` : ''}.`,
      `Résultats comptés par ${NOMS_SOURCE[source]}. Verdicts jugés sur ${NIVEAUX[niveau]}.`,
      `Total : ${resumeResultats(total, total)}.`,
    ];
    if (source === 'tunnel' && sansPub.inscrites + sansPub.rdv + sansPub.ventes > 0) {
      sorties.push(`Sans publicité connue : ${pluriel(sansPub.inscrites, 'inscrite')}, ${ecrire(sansPub.rdv, 'entier')} rendez-vous, ${pluriel(sansPub.ventes, 'vente')}.`);
    }
    const triees = trierPubs(r.pubs, verdicts);
    for (const [cle, nom] of [...Object.entries(VERDICTS), ['', 'Sans dépense sur la période']]) {
      const groupe = triees.filter((ligne) => (verdicts[ligne.cle]?.verdict ?? '') === cle);
      if (groupe.length === 0) continue;
      sorties.push('', `${String(nom).toUpperCase()} (${groupe.length})`);
      groupe.forEach((ligne, rang) => {
        sorties.push(`${rang + 1}. ${ligne.nom} : ${resumeResultats(ligne, resultats(ligne, source))}`);
        if (ligne.titre) sorties.push(`   Titre : ${ligne.titre}`);
        if (ligne.texte) sorties.push(`   Texte : ${ligne.texte.replace(/\s*\n+\s*/g, ' / ')}`);
      });
    }
    const cleInscrites = source === 'meta' ? 'prospects' : 'inscrites';
    const semaine = parJourDeSemaine(r.jours, ['depense', 'prospects', 'inscrites', 'rdv', 'ventes']);
    sorties.push('', 'À QUEL MOMENT');
    sorties.push(
      `Par jour : ${semaine
        .map((ligne) => `${(JOURS_SEMAINE[ligne.jour ?? 0] ?? '').toLowerCase()} ${ecrire(ligne[cleInscrites] ?? 0, 'entier')} inscrites pour ${ecrire(ligne.depense ?? 0, 'euros')}, ${ecrire(ligne.rdv ?? 0, 'entier')} RDV`)
        .join(' ; ')}.`,
    );
    const meilleures = [...r.heures].sort((a, b) => b[cleInscrites] - a[cleInscrites]).slice(0, 5).filter((ligne) => ligne[cleInscrites] > 0);
    if (meilleures.length > 0) sorties.push(`Heures les plus fortes : ${meilleures.map((ligne) => `${ligne.heure} h (${ecrire(ligne[cleInscrites], 'entier')} inscrites)`).join(', ')}.`);
    const delai = (compte: Record<string, number>) => r.delais.tranches.filter((tranche) => (compte[tranche.cle] ?? 0) > 0).map((tranche) => `${tranche.nom.toLowerCase()} ${compte[tranche.cle]}`).join(', ');
    if (delai(r.delais.rdv)) sorties.push(`Rendez-vous pris après l’inscription : ${delai(r.delais.rdv)}.`);
    if (delai(r.delais.vente)) sorties.push(`Ventes après l’inscription : ${delai(r.delais.vente)}.`);
    return sorties.join('\n');
  }

  /** Copie un texte, et le dit sur le bouton. */
  async function copier(texte: string, bouton: HTMLElement) {
    const libelle = bouton.dataset.libelle ?? bouton.textContent ?? '';
    bouton.dataset.libelle = libelle;
    let fait = false;
    try {
      await navigator.clipboard.writeText(texte);
      fait = true;
    } catch {
      // Sans accès au presse-papiers : on passe par une zone de texte.
      const zone = document.createElement('textarea');
      zone.value = texte;
      zone.setAttribute('readonly', '');
      zone.style.position = 'fixed';
      zone.style.opacity = '0';
      document.body.append(zone);
      zone.select();
      try {
        fait = document.execCommand('copy');
      } catch {
        fait = false;
      }
      zone.remove();
    }
    bouton.textContent = fait ? 'Copié ✓' : 'Copie impossible';
    window.setTimeout(() => {
      bouton.textContent = libelle;
    }, 2200);
  }

  async function chargerPubs() {
    if (!etatPubs || !contenuPubs) return;
    demandePubs += 1;
    const numero = demandePubs;
    etatPubs.textContent = 'Chargement du rapport des publicités…';
    etatPubs.hidden = false;
    etatPubs.classList.remove('erreur');
    if (boutonRapport) boutonRapport.disabled = true;
    const periode = choixPeriode?.value ?? 'mois';
    const { statut, corps } = await appeler(`/pubs?mois=${mois}&periode=${encodeURIComponent(periode)}`);
    if (numero !== demandePubs) return;
    if (statut !== 200 || !corps?.ok) {
      rapportPubs = null;
      contenuPubs.hidden = true;
      etatPubs.textContent = statut === 401 ? 'La session est terminée : recharge la page et reconnecte-toi.' : 'Le rapport des publicités n’a pas pu être chargé. Réessaie dans un instant.';
      etatPubs.classList.add('erreur');
      return;
    }
    rapportPubs = corps as RapportPubs;
    afficherPubs();
  }

  choixPeriode?.addEventListener('change', () => void chargerPubs());
  choixSource?.addEventListener('change', () => {
    sourceChoisie = true;
    afficherPubs();
  });
  boutonRapport?.addEventListener('click', () => void copier(texteDuRapport(), boutonRapport));
  $('[data-copier-parametres]')?.addEventListener('click', (evenement) => void copier(rapportPubs?.parametres ?? '', evenement.currentTarget as HTMLElement));

  function signaler(texte: string) {
    if (!erreur) return;
    erreur.textContent = texte;
    erreur.hidden = !texte;
  }

  /* ---------- Échanges avec le serveur ---------- */

  async function appeler(chemin: string, options: RequestInit = {}) {
    try {
      const reponse = await fetch(API + chemin, {
        credentials: 'same-origin',
        headers: options.body ? { 'Content-Type': 'application/json' } : undefined,
        ...options,
      });
      const corps = await reponse.json().catch(() => null);
      return { statut: reponse.status, corps };
    } catch {
      return { statut: 0, corps: null };
    }
  }

  /* ---------- La fenêtre « Ajouter une vente » ---------- */

  const dialogue = $<HTMLDialogElement>('[data-dialogue-vente]');
  const formulaireVente = $<HTMLFormElement>('[data-formulaire-vente]');
  const lignesPaiement = $('[data-paiements]');
  const messageVente = $('[data-message-vente]');
  const supprimerVente = $<HTMLButtonElement>('[data-supprimer-vente]');
  /** Valeur de la liste des closers qui ouvre le champ « nouveau closer ». */
  const NOUVEAU_CLOSER = '__nouveau';
  /** La vente en cours de modification ; null pour une nouvelle vente. */
  let venteOuverte: Vente | null = null;
  /** Vrai tant que l'unique ligne de paiement suit le montant de la vente. */
  let paiementSuitLeMontant = true;
  let dateDeVente = '';

  const champVente = (nom: string) => formulaireVente?.elements.namedItem(nom) as HTMLInputElement | HTMLSelectElement;
  const dire = (texte: string) => {
    if (messageVente) messageVente.textContent = texte;
  };

  const REFUS: Record<string, string> = {
    date: 'Choisis la date de la vente : aujourd’hui ou un jour passé.',
    formule: 'Choisis la formule vendue.',
    montant: 'Indique le montant de la vente, par exemple 3000.',
    commission: 'La commission doit être un montant, au plus égal à celui de la vente.',
    email: 'L’email de l’élève n’est pas lisible. Corrige-le, ou laisse le champ vide.',
    paiements: 'Vérifie les moyens de paiement : chaque ligne a besoin d’un montant et d’un nombre de fois.',
    repartition: 'La somme des paiements doit être égale au montant de la vente.',
    closer: 'Choisis le closer de la vente, ou donne le nom du nouveau.',
    vente: 'Cette vente n’existe plus : recharge la page.',
    'a-brancher': 'La vente n’est pas enregistrée : la base n’est pas encore reliée.',
  };

  /** Une ligne de l'encadré de paiement : moyen, montant, nombre de fois, premier paiement. */
  function ajouterLignePaiement(paiement?: Partial<Paiement>) {
    if (!lignesPaiement) return;
    const ligne = creer('div', '', 'ligne-paiement');
    ligne.dataset.ligne = '';
    const champ = (libelle: string, element: HTMLElement) => {
      const etiquette = creer('label');
      etiquette.append(creer('span', libelle), element);
      return etiquette;
    };

    const methode = creer('select');
    methode.dataset.methode = '';
    for (const [id, moyen] of Object.entries(METHODES)) {
      const option = creer('option', moyen.nom);
      option.value = id;
      methode.append(option);
    }
    methode.value = paiement?.methode ?? 'gocardless';

    const montant = creer('input');
    montant.type = 'text';
    montant.inputMode = 'decimal';
    montant.autocomplete = 'off';
    montant.dataset.montant = '';
    montant.value = paiement?.montant ? String(paiement.montant).replace('.', ',') : '';

    const fois = creer('input');
    fois.type = 'number';
    fois.min = '1';
    fois.max = '48';
    fois.step = '1';
    fois.inputMode = 'numeric';
    fois.dataset.mensualites = '';
    fois.value = String(paiement?.mensualites ?? 1);
    const etiquetteFois = champ('En combien de fois', fois);

    const debut = creer('input');
    debut.type = 'date';
    debut.dataset.debut = '';
    debut.value = paiement?.debut ?? dateDeVente;

    const retirer = creer('button', '✕', 'retirer');
    retirer.type = 'button';
    retirer.setAttribute('aria-label', 'Retirer ce moyen de paiement');
    retirer.addEventListener('click', () => {
      ligne.remove();
      rafraichirVente();
    });

    const selonMethode = () => {
      const moyen = (METHODES as Record<string, { enPlusieursFois: boolean }>)[methode.value];
      etiquetteFois.hidden = !moyen?.enPlusieursFois;
      const libelle = etiquetteFois.querySelector('span');
      // Avec seQura, c'est l'élève qui paie en plusieurs fois : la durée fixe la date du solde.
      if (libelle) libelle.textContent = methode.value === 'sequra' ? 'Mensualités de l’élève' : 'En combien de fois';
    };
    methode.addEventListener('change', () => {
      selonMethode();
      rafraichirVente();
    });
    montant.addEventListener('input', () => {
      paiementSuitLeMontant = false;
      rafraichirVente();
    });
    fois.addEventListener('input', rafraichirVente);
    debut.addEventListener('input', rafraichirVente);
    selonMethode();

    ligne.append(champ('Moyen de paiement', methode), champ('Montant (€)', montant), etiquetteFois, champ('Premier paiement le', debut), retirer);
    lignesPaiement.append(ligne);
  }

  /** Les lignes de paiement telles qu'elles sont saisies. */
  function paiementsSaisis() {
    return [...(lignesPaiement?.querySelectorAll<HTMLElement>('[data-ligne]') ?? [])].map((ligne) => ({
      methode: ligne.querySelector<HTMLSelectElement>('[data-methode]')?.value ?? '',
      montant: ligne.querySelector<HTMLInputElement>('[data-montant]')?.value ?? '',
      mensualites: Number(ligne.querySelector<HTMLInputElement>('[data-mensualites]')?.value || 1),
      debut: ligne.querySelector<HTMLInputElement>('[data-debut]')?.value ?? '',
    }));
  }

  /** Met à jour ce qui dépend de la saisie : le reste à répartir et l'échéancier. */
  function rafraichirVente() {
    const lignes = [...(lignesPaiement?.querySelectorAll<HTMLElement>('[data-ligne]') ?? [])];
    for (const ligne of lignes) {
      const retirer = ligne.querySelector<HTMLButtonElement>('.retirer');
      if (retirer) retirer.disabled = lignes.length === 1;
    }
    const montant = lireMontant(champVente('montant')?.value ?? '') ?? 0;
    const saisis = paiementsSaisis();
    const reparti = saisis.reduce((total, paiement) => total + (lireMontant(paiement.montant) ?? 0), 0);
    const reste = Math.round((montant - reparti) * 100) / 100;
    const etat = $('[data-reste-a-repartir]');
    if (etat) {
      etat.dataset.etat = !montant ? '' : reste === 0 ? 'bon' : 'a-revoir';
      etat.textContent = !montant
        ? ''
        : reste === 0
          ? 'Le compte est bon.'
          : reste > 0
            ? `Reste à répartir : ${argent(reste)}`
            : `Les paiements dépassent la vente de ${argent(-reste)}`;
    }

    // L'échéancier : ce que l'Académie encaisse, et quand.
    const liste = $('[data-echeancier]');
    const resume = $('[data-resume-echeancier]');
    const date = champVente('date')?.value ?? '';
    const aujourdHui = donnees?.aujourdHui ?? '';
    const paiements = saisis
      .map((paiement) => ({ ...paiement, montant: lireMontant(paiement.montant) ?? 0, debut: paiement.debut || date }))
      .filter((paiement) => paiement.montant > 0 && paiement.debut);
    const echeances = date ? echeancier({ date, paiements }) : [];
    if (liste) {
      liste.replaceChildren(
        ...(echeances.length === 0
          ? [creer('li', 'Indique le montant et le moyen de paiement : les encaissements s’affichent ici.', 'vide')]
          : echeances.map((echeance) => {
              const element = creer('li', '', echeance.date <= aujourdHui ? 'encaisse' : '');
              element.append(creer('span', libelleDate(echeance.date)), creer('strong', argent(echeance.montant)), creer('span', `${nomMethode(echeance.methode)}, ${echeance.etape}`));
              return element;
            })),
      );
    }
    if (resume) {
      const deja = echeances.reduce((total, echeance) => total + (echeance.date <= aujourdHui ? echeance.montant : 0), 0);
      resume.textContent =
        echeances.length === 0 ? '' : `Déjà encaissé aujourd’hui : ${argent(Math.round(deja * 100) / 100)}. À venir : ${argent(Math.round((reparti - deja) * 100) / 100)}.`;
    }
  }

  /** Ouvre la fenêtre : vide pour une nouvelle vente, remplie pour une vente à modifier. */
  function ouvrirVente(vente?: Vente) {
    const d = donnees;
    if (!d || !dialogue || !formulaireVente || !lignesPaiement) return;
    venteOuverte = vente ?? null;
    formulaireVente.reset();
    dire('');
    const titre = $('[data-titre-vente]');
    if (titre) titre.textContent = vente ? 'Modifier la vente' : 'Ajouter une vente';
    if (supprimerVente) {
      supprimerVente.hidden = !vente;
      supprimerVente.textContent = 'Supprimer cette vente';
      delete supprimerVente.dataset.confirme;
    }

    const date = champVente('date') as HTMLInputElement;
    date.max = d.aujourdHui;
    // Par défaut : aujourd'hui, ou le dernier jour du mois affiché si c'est un mois passé.
    const dernierJour = d.jours.filter((jour) => jour.date <= d.aujourdHui).at(-1)?.date ?? d.aujourdHui;
    date.value = vente?.date ?? (d.mois === d.aujourdHui.slice(0, 7) ? d.aujourdHui : dernierJour);
    dateDeVente = date.value;
    champVente('formule').value = vente?.formule ?? '';
    champVente('montant').value = vente ? String(vente.montant).replace('.', ',') : '';
    champVente('commission').value = vente?.commission ? String(vente.commission).replace('.', ',') : '';
    champVente('note').value = vente?.note ?? '';
    champVente('email').value = vente?.email ?? '';

    // Les closers déjà enregistrés se choisissent ; un nouveau nom s'enregistre avec la vente.
    const closers = champVente('closer') as HTMLSelectElement;
    const option = (valeur: string, texte: string) => {
      const element = creer('option', texte);
      element.value = valeur;
      return element;
    };
    const connus = d.closers.map((closer) => option(closer.id, closer.nom));
    // Le closer d'une ancienne vente, retiré de la liste depuis, reste proposé pour cette vente.
    if (vente && !d.closers.some((closer) => closer.id === vente.closer)) connus.push(option(vente.closer, vente.closerNom));
    closers.replaceChildren(option('', 'Choisir…'), ...connus, option(NOUVEAU_CLOSER, '＋ Nouveau closer…'));
    closers.value = vente?.closer ?? (d.closers.length === 0 ? NOUVEAU_CLOSER : '');
    const nouveau = $('[data-nouveau-closer]');
    if (nouveau) nouveau.hidden = closers.value !== NOUVEAU_CLOSER;

    lignesPaiement.replaceChildren();
    paiementSuitLeMontant = !vente;
    if (vente) for (const paiement of vente.paiements) ajouterLignePaiement(paiement);
    else ajouterLignePaiement();
    rafraichirVente();
    dialogue.showModal();
    (vente ? champVente('montant') : champVente('formule')).focus();
  }

  $('[data-ajouter-vente]')?.addEventListener('click', () => ouvrirVente());
  for (const bouton of document.querySelectorAll('[data-fermer-vente]')) bouton.addEventListener('click', () => dialogue?.close());

  champVente('closer')?.addEventListener('change', () => {
    const nouveau = $('[data-nouveau-closer]');
    const choisi = champVente('closer').value === NOUVEAU_CLOSER;
    if (nouveau) nouveau.hidden = !choisi;
    if (choisi) champVente('closerNom').focus();
  });

  champVente('montant')?.addEventListener('input', () => {
    // Tant qu'il n'y a qu'un moyen de paiement et qu'il n'a pas été retouché, il suit le montant.
    const lignes = lignesPaiement?.querySelectorAll<HTMLInputElement>('[data-ligne] [data-montant]');
    if (paiementSuitLeMontant && lignes?.length === 1 && lignes[0]) lignes[0].value = champVente('montant').value;
    rafraichirVente();
  });

  champVente('date')?.addEventListener('input', () => {
    // Les premiers paiements calés sur la date de la vente la suivent.
    const nouvelle = champVente('date').value;
    for (const debut of lignesPaiement?.querySelectorAll<HTMLInputElement>('[data-debut]') ?? []) {
      if (debut.value === dateDeVente) debut.value = nouvelle;
    }
    dateDeVente = nouvelle;
    rafraichirVente();
  });

  $('[data-ajouter-paiement]')?.addEventListener('click', () => {
    const montant = lireMontant(champVente('montant')?.value ?? '') ?? 0;
    const reparti = paiementsSaisis().reduce((total, paiement) => total + (lireMontant(paiement.montant) ?? 0), 0);
    const reste = Math.round((montant - reparti) * 100) / 100;
    paiementSuitLeMontant = false;
    ajouterLignePaiement({ methode: 'sequra', montant: reste > 0 ? reste : undefined });
    rafraichirVente();
  });

  formulaireVente?.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();
    const d = donnees;
    if (!d) return;
    dire('');
    const choix = champVente('closer').value;
    const closerNom = (champVente('closerNom').value ?? '').trim();
    const lue = normaliserVente(
      {
        date: champVente('date').value,
        formule: champVente('formule').value,
        montant: champVente('montant').value,
        commission: champVente('commission').value,
        paiements: paiementsSaisis(),
        note: champVente('note').value,
        email: champVente('email').value,
      },
      { aujourdHui: d.aujourdHui },
    );
    if (!lue.ok) return dire(REFUS[lue.erreur] ?? 'Vérifie la saisie.');
    if (!choix || (choix === NOUVEAU_CLOSER && !closerNom)) return dire(REFUS.closer ?? '');

    const envoyer = formulaireVente.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (envoyer) envoyer.disabled = true;
    const resultat = await appeler('/vente', {
      method: 'POST',
      body: JSON.stringify({
        mois,
        vente: { ...lue.vente, id: venteOuverte?.id, closer: choix === NOUVEAU_CLOSER ? undefined : choix },
        closerNom: choix === NOUVEAU_CLOSER ? closerNom : venteOuverte?.closerNom,
      }),
    });
    if (envoyer) envoyer.disabled = false;
    if (resultat.statut !== 200 || !resultat.corps?.ok) {
      return dire(
        REFUS[String(resultat.corps?.erreur)] ??
          (resultat.statut === 401 ? 'La session est terminée : recharge la page et reconnecte-toi.' : 'La vente n’a pas pu être enregistrée. Réessaie dans un instant.'),
      );
    }
    dialogue?.close();
    signaler('');
    // Une vente d'un autre mois s'affiche dans son mois.
    const moisDeVente = lue.vente.date.slice(0, 7);
    if (moisDeVente !== mois && moisDeVente >= PREMIER_MOIS) changerDeMois(moisDeVente);
    else appliquerVentes(resultat.corps as BlocVentes);
  });

  supprimerVente?.addEventListener('click', async () => {
    if (!venteOuverte) return;
    // Un premier clic demande confirmation, le second supprime.
    if (!supprimerVente.dataset.confirme) {
      supprimerVente.dataset.confirme = 'oui';
      supprimerVente.textContent = 'Confirmer la suppression';
      return;
    }
    const resultat = await appeler(`/vente?id=${encodeURIComponent(venteOuverte.id)}&mois=${mois}`, { method: 'DELETE' });
    if (resultat.statut !== 200 || !resultat.corps?.ok) return dire('La vente n’a pas pu être supprimée. Réessaie dans un instant.');
    dialogue?.close();
    appliquerVentes(resultat.corps as BlocVentes);
  });

  function remplirChoixDuMois() {
    if (!choixMois) return;
    const courant = moisCourant();
    const liste: string[] = [];
    for (let m = courant; m >= PREMIER_MOIS; m = moisDecale(m, -1)) liste.push(m);
    if (!liste.includes(mois)) liste.push(mois);
    choixMois.replaceChildren(
      ...liste.map((m) => {
        const option = creer('option', libelleMois(m));
        option.value = m;
        option.selected = m === mois;
        return option;
      }),
    );
    const suivant = $<HTMLButtonElement>('[data-mois-suivant]');
    const precedent = $<HTMLButtonElement>('[data-mois-precedent]');
    if (suivant) suivant.disabled = mois >= courant;
    if (precedent) precedent.disabled = mois <= PREMIER_MOIS;
  }

  async function charger() {
    signaler('');
    remplirChoixDuMois();
    if (!donnees) montrer('attente');
    const { statut, corps } = await appeler(`/donnees?mois=${mois}`);
    if (statut === 200 && corps?.ok) {
      const url = new URL(window.location.href);
      url.searchParams.set('mois', mois);
      window.history.replaceState(null, '', url);
      afficher(corps as Donnees);
      montrer('tableau');
      // Le rapport des publicités se charge à part : il est plus long à assembler.
      void chargerPubs();
      return;
    }
    donnees = null;
    montrer('porte');
    // Sans mot de passe réglé dans Vercel, il n'y a rien à saisir : la porte le dit
    // et ne propose pas de champ.
    const ferme = statut === 503 && corps?.erreur === 'non-regle';
    if (connexion) connexion.hidden = ferme;
    if (textePorte) {
      textePorte.textContent = ferme
        ? 'Le cockpit est fermé : son mot de passe n’est pas encore réglé (variable COCKPIT_MOT_DE_PASSE dans Vercel).'
        : invitation;
    }
    if (message) message.textContent = !ferme && statut !== 401 ? 'Le cockpit ne répond pas. Réessaie dans un instant.' : '';
  }

  function changerDeMois(nouveau: string) {
    if (!moisValide(nouveau) || nouveau > moisCourant() || nouveau < PREMIER_MOIS) return;
    mois = nouveau;
    void charger();
  }

  $('[data-mois-precedent]')?.addEventListener('click', () => changerDeMois(moisDecale(mois, -1)));
  $('[data-mois-suivant]')?.addEventListener('click', () => changerDeMois(moisDecale(mois, 1)));
  choixMois?.addEventListener('change', () => changerDeMois(choixMois.value));

  connexion?.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();
    const formulaire = evenement.currentTarget as HTMLFormElement;
    const champ = formulaire.elements.namedItem('motDePasse') as HTMLInputElement;
    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (message) message.textContent = '';
    if (!champ.value) {
      if (message) message.textContent = 'Entre le mot de passe.';
      return;
    }
    if (bouton) bouton.disabled = true;
    const { statut, corps } = await appeler('/connexion', { method: 'POST', body: JSON.stringify({ motDePasse: champ.value }) });
    if (bouton) bouton.disabled = false;
    if (statut === 200) {
      champ.value = '';
      await charger();
      return;
    }
    if (!message) return;
    if (statut === 401) message.textContent = 'Mot de passe incorrect.';
    else if (statut === 429) message.textContent = 'Trop d’essais. Réessaie dans dix minutes.';
    else if (statut === 503 && corps?.erreur === 'non-regle') message.textContent = 'Le mot de passe du cockpit n’est pas encore réglé dans Vercel.';
    else message.textContent = 'Connexion impossible pour le moment. Réessaie dans un instant.';
  });

  $('[data-deconnexion]')?.addEventListener('click', async () => {
    await appeler('/connexion', { method: 'DELETE' });
    donnees = null;
    montrer('porte');
  });

  void charger();
</script>
