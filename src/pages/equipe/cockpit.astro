---
/**
 * Cockpit : les chiffres du tunnel, mois par mois, avec le détail jour par jour,
 * en trois parties (Acquisition, VSL, Closing). Modèle : le tableau publicitaire
 * d'origine, sans second appel (R1 closing). Les ventes s'enregistrent ici
 * (« Ajouter une vente ») : formule, montant, closer et commission, moyens de
 * paiement. Le cockpit en tire le commandé, l'encaissé, le reste à encaisser,
 * ce qui doit entrer en caisse les mois suivants (MRR) et les commissions.
 * Quatrième partie, « Publicités » : chaque création publicitaire, de sa dépense
 * aux inscrites, aux rendez-vous et aux ventes qu'elle amène, et à quels moments.
 * Les cartes « Suivi du tunnel » disent si chaque maillon est en place
 * (ActiveCampaign, rendez-vous, liste Client, API de conversion Meta).
 *
 * Accès privé : cette page ne contient aucun chiffre. Elle demande le mot de
 * passe, puis lit les chiffres auprès de /api/cockpit/donnees, qui exige une
 * session ouverte. Rien n'est indexé.
 */
import Tunnel from '../../layouts/Tunnel.astro';
import { CHEMINS } from '../../reglages';
import { FORMULES } from '../../../partage/ventes.js';
---

<Tunnel titre="Cockpit · Académie Florale" pied="compact">
  <div class="cockpit">
    <!-- La porte : mot de passe -->
    <section class="porte" data-porte hidden>
      <h1>Cockpit</h1>
      <p data-porte-texte>Accès privé. Entre le mot de passe pour voir les chiffres du tunnel.</p>
      <form data-connexion novalidate>
        <label for="mot-de-passe">Mot de passe</label>
        <input id="mot-de-passe" name="motDePasse" type="password" autocomplete="current-password" required />
        <button class="bouton bouton-large" type="submit">Ouvrir le cockpit</button>
        <p class="message" data-message role="alert"></p>
      </form>
      <p class="texte-secondaire"><a href={CHEMINS.equipe}>Retour à la bibliothèque de liens</a></p>
    </section>

    <p class="attente" data-attente>Chargement du cockpit…</p>

    <!-- Le tableau de bord -->
    <div class="tableau-de-bord" data-tableau hidden>
      <header class="tete">
        <div class="titre">
          <h1>Cockpit</h1>
          <p class="texte-secondaire">
            <a href={CHEMINS.equipe}>Bibliothèque de liens</a> ·
            <button type="button" class="lien" data-deconnexion>Se déconnecter</button>
          </p>
        </div>
        <div class="mois" role="group" aria-label="Choix du mois">
          <button type="button" class="fleche" data-mois-precedent aria-label="Mois précédent">‹</button>
          <select data-mois aria-label="Mois affiché"></select>
          <button type="button" class="fleche" data-mois-suivant aria-label="Mois suivant">›</button>
        </div>
      </header>

      <p class="bandeau demonstration" data-demonstration hidden>
        <strong>Données de démonstration.</strong> Ces chiffres sont inventés : ils servent à mettre au point l’affichage,
        en local seulement.
      </p>
      <p class="bandeau erreur" data-erreur role="alert" hidden></p>

      <section class="branchements" aria-labelledby="titre-branchements">
        <h2 id="titre-branchements" class="visuellement-cache">Sources des chiffres</h2>
        <ul data-sources role="list"></ul>
      </section>

      <section class="branchements suivi" aria-labelledby="titre-suivi" data-bloc-suivi hidden>
        <h2 id="titre-suivi" class="titre-suivi">Suivi du tunnel</h2>
        <ul data-suivi role="list"></ul>
      </section>

      <nav class="sommaire" aria-label="Parties du cockpit">
        <a href="#acquisition">Acquisition</a>
        <a href="#vsl">VSL</a>
        <a href="#closing">Closing</a>
        <a href="#publicites">Publicités</a>
      </nav>

      <section class="partie" id="acquisition" aria-labelledby="titre-acquisition">
        <div class="tete-partie">
          <h2 id="titre-acquisition"><span class="numero" aria-hidden="true">1</span>Acquisition</h2>
          <p class="texte-secondaire">De la publicité à l’inscription. Dépense, impressions et clics : Meta Ads. Inscrits : formulaire de la landing.</p>
        </div>
        <ul class="cartes" data-cartes="acquisition" role="list"></ul>
        <div class="defilement" tabindex="0" role="region" aria-label="Acquisition, jour par jour">
          <table data-table="acquisition"></table>
        </div>
        <div class="formulations" data-formulations hidden>
          <h3>Test des formulations de la landing</h3>
          <div class="defilement" tabindex="0" role="region" aria-label="Test des formulations">
            <table data-table="formulations"></table>
          </div>
        </div>
      </section>

      <section class="partie" id="vsl" aria-labelledby="titre-vsl">
        <div class="tete-partie">
          <h2 id="titre-vsl"><span class="numero" aria-hidden="true">2</span>VSL</h2>
          <p class="texte-secondaire">De l’inscription à l’appel réservé. Lectures de la vidéo : Wistia. Appels réservés : iClosed, à leur date de réservation.</p>
        </div>
        <ul class="cartes" data-cartes="vsl" role="list"></ul>
        <div class="defilement" tabindex="0" role="region" aria-label="VSL, jour par jour">
          <table data-table="vsl"></table>
        </div>
      </section>

      <section class="partie" id="closing" aria-labelledby="titre-closing">
        <div class="tete-partie avec-action">
          <div>
            <h2 id="titre-closing"><span class="numero" aria-hidden="true">3</span>Closing</h2>
            <p class="texte-secondaire">
              De l’appel à la vente, en un seul appel (R1). Annulations et absences au jour prévu de l’appel : iClosed. Ventes :
              celles que tu enregistres ici.
            </p>
          </div>
          <button type="button" class="bouton" data-ajouter-vente hidden>＋ Ajouter une vente</button>
        </div>
        <ul class="cartes" data-cartes="closing" role="list"></ul>
        <div class="defilement" tabindex="0" role="region" aria-label="Closing, jour par jour">
          <table data-table="closing"></table>
        </div>

        <div class="bloc" data-bloc-ventes hidden>
          <h3>Ventes du mois</h3>
          <p class="texte-secondaire" data-aucune-vente>Aucune vente enregistrée ce mois-ci.</p>
          <div class="defilement" tabindex="0" role="region" aria-label="Ventes du mois" data-cadre-ventes>
            <table data-table="ventes"></table>
          </div>
        </div>

        <div class="bloc" data-bloc-commissions hidden>
          <h3>Commissions du mois</h3>
          <div class="defilement" tabindex="0" role="region" aria-label="Commissions du mois">
            <table data-table="commissions"></table>
          </div>
        </div>

        <div class="bloc" data-bloc-encaissements hidden>
          <h3>MRR : ce qui doit être encaissé, mois par mois</h3>
          <p class="texte-secondaire">
            Toutes ventes confondues, d’après l’échéancier de chaque vente. Une échéance passée est comptée comme encaissée : le
            cockpit ne connaît pas les impayés.
          </p>
          <ul class="cartes" data-cartes="encaissements" role="list"></ul>
          <div class="defilement" tabindex="0" role="region" aria-label="MRR, mois par mois">
            <table data-table="encaissements"></table>
          </div>
        </div>

        <div class="bloc" data-bloc-closers hidden>
          <h3>Closers enregistrés</h3>
          <ul class="closers" data-closers role="list"></ul>
        </div>
      </section>

      <section class="partie" id="publicites" aria-labelledby="titre-publicites">
        <div class="tete-partie avec-action">
          <div>
            <h2 id="titre-publicites"><span class="numero" aria-hidden="true">4</span>Publicités</h2>
            <p class="texte-secondaire">
              De la publicité au rendez-vous, puis à la vente : ce que chaque création amène, et à quel moment. Une création
              diffusée dans plusieurs ensembles ne fait qu’une ligne.
            </p>
          </div>
          <div class="reglages-pubs">
            <label>
              Période
              <select data-pubs-periode>
                <option value="mois">Le mois affiché</option>
                <option value="3m">3 derniers mois</option>
                <option value="12m">12 derniers mois</option>
              </select>
            </label>
            <label>
              Résultats comptés par
              <select data-pubs-source>
                <option value="tunnel">Le tunnel</option>
                <option value="meta">Meta</option>
              </select>
            </label>
            <button type="button" class="bouton" data-copier-rapport disabled>Copier le rapport</button>
          </div>
        </div>
        <p class="bandeau" data-pubs-etat role="status">Chargement du rapport des publicités…</p>
        <div data-pubs-contenu hidden>
          <p class="texte-secondaire" data-pubs-legende></p>
          <ul class="cartes" data-cartes="publicites" role="list"></ul>
          <div class="defilement" tabindex="0" role="region" aria-label="Créations publicitaires">
            <table data-table="publicites"></table>
          </div>
          <p class="texte-secondaire" data-pubs-regle></p>

          <div class="bloc">
            <h3>À quel moment</h3>
            <div class="moments">
              <div class="moment">
                <h4>Par jour de la semaine</h4>
                <div class="defilement" tabindex="0" role="region" aria-label="Par jour de la semaine">
                  <table data-table="semaine"></table>
                </div>
              </div>
              <div class="moment">
                <h4>Par heure (heure de Paris)</h4>
                <div class="defilement" tabindex="0" role="region" aria-label="Par heure">
                  <table data-table="heures"></table>
                </div>
              </div>
              <div class="moment">
                <h4>Combien de temps après l’inscription</h4>
                <div class="defilement" tabindex="0" role="region" aria-label="Délai après l’inscription">
                  <table data-table="delais"></table>
                </div>
                <p class="texte-secondaire">Pour les inscrites passées par la landing du nouveau tunnel.</p>
              </div>
            </div>
          </div>

          <div class="bloc">
            <h3>Paramètres d’URL à mettre dans chaque publicité</h3>
            <p class="texte-secondaire">
              Dans Meta, champ « Paramètres d’URL » de la publicité. Sans eux, une inscrite ne peut pas être rattachée à sa
              publicité : elle est comptée dans « Sans publicité connue ».
            </p>
            <p class="parametres"><code data-pubs-parametres></code><button type="button" class="lien" data-copier-parametres>Copier</button></p>
          </div>
        </div>
      </section>
    </div>

    <!-- La fenêtre « Ajouter une vente » -->
    <dialog class="vente" data-dialogue-vente aria-labelledby="titre-vente">
      <form data-formulaire-vente novalidate>
        <header>
          <h2 id="titre-vente" data-titre-vente>Ajouter une vente</h2>
          <button type="button" class="fermer" data-fermer-vente aria-label="Fermer sans enregistrer">✕</button>
        </header>

        <div class="champs">
          <label>
            Date de la vente
            <input type="date" name="date" required />
          </label>
          <label>
            Formule
            <select name="formule" required>
              <option value="">Choisir…</option>
              {Object.entries(FORMULES).map(([id, nom]) => <option value={id}>{nom}</option>)}
            </select>
          </label>
          <label>
            Montant de la vente (€)
            <input type="text" name="montant" inputmode="decimal" autocomplete="off" placeholder="3 000" required />
          </label>
          <label>
            Closer
            <select name="closer" required></select>
          </label>
          <label data-nouveau-closer hidden>
            Nom du nouveau closer
            <input type="text" name="closerNom" maxlength="60" autocomplete="off" />
          </label>
          <label>
            Commission du closer (€)
            <input type="text" name="commission" inputmode="decimal" autocomplete="off" placeholder="0" />
          </label>
          <label class="pleine-largeur">
            Email de l’élève
            <input type="email" name="email" inputmode="email" autocomplete="off" spellcheck="false" placeholder="prenom@exemple.fr" maxlength="254" />
            <span class="aide-champ">
              Avec son email, elle entre dans la liste « Client » d’ActiveCampaign et sort de « Prospect », l’achat est envoyé à
              Meta, et la vente est rattachée à la publicité qui l’a fait s’inscrire.
            </span>
          </label>
        </div>

        <fieldset class="paiement">
          <legend>Comment la vente est payée</legend>
          <p class="texte-secondaire">
            Une ligne par moyen de paiement. Par exemple : un dépôt en GoCardless, puis le reste en seQura en 6 fois.
          </p>
          <div data-paiements></div>
          <div class="pied-paiement">
            <button type="button" class="lien" data-ajouter-paiement>＋ Ajouter un moyen de paiement</button>
            <p data-reste-a-repartir role="status"></p>
          </div>
        </fieldset>

        <section class="echeancier" aria-live="polite">
          <h3>Ce que l’Académie encaisse, et quand</h3>
          <ul data-echeancier role="list"></ul>
          <p class="texte-secondaire" data-resume-echeancier></p>
        </section>

        <label class="note-vente">
          Note (facultative)
          <input type="text" name="note" maxlength="200" autocomplete="off" />
        </label>

        <p class="message" data-message-vente role="alert"></p>
        <footer>
          <button type="button" class="lien danger" data-supprimer-vente hidden>Supprimer cette vente</button>
          <span class="espace"></span>
          <button type="button" class="lien" data-fermer-vente>Annuler</button>
          <button type="submit" class="bouton">Enregistrer la vente</button>
        </footer>
      </form>
    </dialog>
  </div>
</Tunnel>

<style>
  .cockpit {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding: 0 clamp(12px, 3vw, 32px) clamp(32px, 6vw, 60px);
  }

  /* La porte */
  .porte {
    display: grid;
    gap: 14px;
    max-width: 24rem;
    margin: clamp(16px, 6vw, 56px) auto 0;
    text-align: center;
  }

  .porte form {
    display: grid;
    gap: 10px;
    padding: 20px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
    text-align: left;
  }

  .porte label {
    font-size: var(--corps-petit);
    font-weight: 600;
  }

  .porte input {
    width: 100%;
    min-height: 52px;
    padding: 0.6em 0.9em;
    border: 1.5px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
    color: var(--encre);
    font-family: var(--police-texte);
    font-size: var(--corps-champ);
  }

  .message {
    color: var(--erreur);
    font-size: var(--corps-petit);
    font-weight: 500;
  }

  .message:empty {
    display: none;
  }

  .attente {
    padding-block: 48px;
    color: var(--encre-douce);
    text-align: center;
  }

  /* L'en-tête du tableau de bord */
  .tableau-de-bord {
    display: grid;
    gap: clamp(16px, 2.6vw, 26px);
  }

  .tete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  h1 {
    font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.4rem);
  }

  .cockpit :global(.lien) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .mois {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mois select,
  .fleche {
    min-height: 46px;
    border: 1.5px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
    color: var(--encre);
    font-family: var(--police-texte);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .mois select {
    padding: 0 0.9em;
    text-transform: capitalize;
  }

  .fleche {
    width: 46px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .fleche:disabled {
    color: var(--trait);
    cursor: default;
  }

  .bandeau {
    padding: 12px 16px;
    border-radius: var(--rayon);
    font-size: var(--corps-petit);
    line-height: 1.4;
  }

  .demonstration {
    background: var(--jaune);
  }

  .erreur {
    border: 1.5px solid var(--erreur);
    background: var(--blanc);
    color: var(--erreur);
    font-weight: 500;
  }

  /* Les sources : branchées ou non */
  .branchements ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .branchements :global(li) {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
    font-size: var(--corps-petit);
    line-height: 1.35;
  }

  .branchements :global(.etat) {
    font-weight: 600;
  }

  .branchements :global(.ok .etat) {
    color: var(--vert-trustpilot);
  }

  .branchements :global(.erreur-source .etat) {
    color: var(--erreur);
  }

  .branchements :global(.detail) {
    color: var(--encre-douce);
    overflow-wrap: anywhere;
  }

  .branchements :global(code) {
    font-size: 0.78rem;
  }

  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sommaire a {
    padding: 0.45em 1.1em;
    border-radius: var(--rayon-bouton);
    background: var(--rose);
    font-size: var(--corps-petit);
    font-weight: 600;
    text-decoration: none;
  }

  /* Une partie : titre, cartes du mois, tableau des jours */
  .partie {
    display: grid;
    gap: 14px;
    scroll-margin-top: 12px;
  }

  .tete-partie {
    display: grid;
    gap: 4px;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--titre-2);
  }

  h3 {
    font-size: 1.05rem;
  }

  .numero {
    display: grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--jaune);
    font-size: 0.62em;
    font-weight: 700;
  }

  .cartes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cartes :global(li) {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--rayon);
    background: var(--blanc);
    box-shadow: 0 14px 30px -26px var(--ombre);
  }

  .cartes :global(.libelle) {
    color: var(--encre-douce);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cartes :global(.valeur) {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .cartes :global(.precision) {
    color: var(--encre-douce);
    font-size: 0.78rem;
  }

  .formulations {
    display: grid;
    gap: 8px;
  }

  /* Tableaux : larges, ils défilent dans leur cadre ; la date reste visible */
  .defilement {
    overflow-x: auto;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
    white-space: nowrap;
  }

  table :global(th),
  table :global(td) {
    padding: 7px 10px;
    border-bottom: 1px solid var(--trait);
    text-align: right;
  }

  table :global(thead th) {
    position: sticky;
    top: 0;
    background: var(--rose);
    font-weight: 700;
  }

  table :global(th[title]) {
    cursor: help;
  }

  table :global(th:first-child),
  table :global(td:first-child) {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--blanc);
    text-align: left;
    font-weight: 600;
  }

  table :global(thead th:first-child) {
    z-index: 2;
    background: var(--rose);
  }

  table :global(tr.dimanche td:first-child) {
    color: var(--orange-fonce);
  }

  table :global(tr.aujourd-hui td) {
    background: var(--creme);
  }

  table :global(td.vide) {
    color: var(--trait);
  }

  table :global(tbody tr td.vente) {
    background: var(--vert-trustpilot);
    color: var(--blanc);
    font-weight: 700;
  }

  table :global(tfoot td) {
    position: sticky;
    bottom: 0;
    border-top: 2px solid var(--encre);
    border-bottom: 0;
    background: var(--creme);
    font-weight: 700;
  }

  table :global(tfoot td:first-child) {
    background: var(--creme);
  }

  table :global(td.note) {
    max-width: 16rem;
    padding: 2px 6px;
    text-align: left;
    white-space: normal;
  }

  table :global(td.note button) {
    width: 100%;
    min-width: 7rem;
    min-height: 30px;
    padding: 3px 6px;
    border: 1px dashed transparent;
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: text;
  }

  table :global(td.note button:hover),
  table :global(td.note button:focus-visible) {
    border-color: var(--trait);
  }

  table :global(td.note input) {
    width: 100%;
    min-width: 12rem;
    min-height: 30px;
    padding: 3px 6px;
    border: 1.5px solid var(--encre);
    border-radius: 6px;
    font: inherit;
  }

  /* Le Closing : bouton d'action, listes des ventes, des commissions et des encaissements */
  .avec-action {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .avec-action > div {
    display: grid;
    flex: 1 1 26rem;
    gap: 4px;
  }

  .bloc {
    display: grid;
    gap: 8px;
