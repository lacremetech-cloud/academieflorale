---
/**
 * Mur d'avis Trustpilot : la note du profil, puis tous les avis publiés (étoiles,
 * titre, nom, mois), aux couleurs de Trustpilot pour qu'on les reconnaisse.
 * Les titres sont ceux publiés ; le texte complet de chaque avis se lit sur Trustpilot.
 */
import { TOUS_LES_AVIS, TRUSTPILOT } from '../contenu/avis';
import { insecables } from '../scripts/typographie';

const note = TRUSTPILOT.note.toLocaleString('fr-FR', { minimumFractionDigits: 1 });
const mois = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });

/** Cinq cases : pleine, demie ou vide. */
function cases(valeur: number): string[] {
  const pleines = Math.floor(valeur);
  const demie = valeur - pleines >= 0.5;
  return Array.from({ length: 5 }, (_, i) => (i < pleines ? 'pleine' : i === pleines && demie ? 'demie' : 'vide'));
}
---

<div class="mur-avis">
  <a class="note" href={TRUSTPILOT.profil} target="_blank" rel="noopener">
    <span class="etoiles grandes" role="img" aria-label={`${note} sur 5`}>
      {cases(TRUSTPILOT.etoiles).map((type) => <span class:list={['etoile', type]}>★</span>)}
    </span>
    <span class="resume">
      <strong>{TRUSTPILOT.mention} · {note} sur 5</strong>
      <span>{TRUSTPILOT.nombre} avis sur <span class="marque"><span aria-hidden="true">★</span>Trustpilot</span></span>
    </span>
  </a>

  <ul class="cartes" role="list">
    {
      TOUS_LES_AVIS.map((avis) => (
        <li class="carte">
          <span class="etoiles" role="img" aria-label={`${avis.note} étoiles sur 5`}>
            {cases(avis.note).map((type) => <span class:list={['etoile', type]}>★</span>)}
          </span>
          <p class="titre">«&nbsp;{insecables(avis.titre)}&nbsp;»</p>
          <p class="auteur">
            <span class="nom">{avis.nom}</span>
            <span class="date">{mois.format(new Date(avis.date))}</span>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="tous">
    <a href={TRUSTPILOT.profil} target="_blank" rel="noopener">Lire les avis en entier sur Trustpilot</a>
  </p>
</div>

<style>
  .mur-avis {
    display: grid;
    gap: clamp(16px, 3vw, 26px);
  }

  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 14px;
    color: var(--encre);
    text-decoration: none;
  }

  .resume {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 10px;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  /* Étoiles façon Trustpilot : blanches sur carrés verts. */
  .etoiles {
    display: inline-flex;
    gap: 2px;
    flex: none;
    font-size: 0.8rem;
  }

  .etoiles.grandes {
    gap: 3px;
    font-size: 1.35rem;
  }

  .etoile {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    background: var(--vert-trustpilot);
    color: var(--blanc);
    font-size: 0.8em;
    line-height: 1;
  }

  .etoile.demie {
    background: linear-gradient(90deg, var(--vert-trustpilot) 50%, var(--trait) 50%);
  }

  .etoile.vide {
    background: var(--trait);
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 700;
  }

  .marque span {
    color: var(--vert-trustpilot);
    font-size: 1.25em;
    line-height: 1;
  }

  /* Le mur : des colonnes où les cartes s'empilent, deux sur téléphone, quatre sur ordinateur. */
  .cartes {
    columns: 2;
    column-gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .carte {
    display: grid;
    gap: 7px;
    break-inside: avoid;
    margin-bottom: 10px;
    padding: 12px 13px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
  }

  .titre {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .auteur {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    color: var(--encre-douce);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .nom {
    font-weight: 600;
  }

  .tous {
    font-size: var(--corps-petit);
    text-align: center;
  }

  @media (min-width: 700px) {
    .cartes {
      columns: 3;
      column-gap: 14px;
    }

    .carte {
      margin-bottom: 14px;
      padding: 15px 17px;
    }

    .titre {
      font-size: 1rem;
    }

    .auteur {
      font-size: 0.82rem;
    }
  }

  @media (min-width: 1000px) {
    .cartes {
      columns: 4;
    }
  }
</style>
