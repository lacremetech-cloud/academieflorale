---
/**
 * Formulaire de la landing, intégré à la page (pas de modale).
 * Il valide les champs, envoie à /api/lead, garde le prénom, l'email et le
 * téléphone en session, puis mène à la page suivante avec les UTM.
 *
 * Les textes passent par des propriétés : ceux de la landing viendront des
 * modèles validés. Les messages d'erreur ci-dessous sont des valeurs par défaut.
 *
 * Téléphone : la visiteuse tape son numéro comme d'habitude. L'indicatif vient du
 * pays, présélectionné d'après son adresse IP (/api/pays), sinon d'après le
 * fuseau horaire de son navigateur. Elle peut toujours le changer.
 */
import { PAYS_TELEPHONE } from '../../partage/validation.js';

interface Props {
  /** Identifiant unique sur la page (sert aux attributs id des champs). */
  id?: string;
  /** Page suivante, après un envoi réussi. */
  suivant: string;
  /** Libellé du bouton d'envoi. */
  bouton: string;
  /** Source déclarée par la landing : « meta » pose le tag « VSL Meta Ads ». */
  source?: string;
  /** Identifiant de la page ou de la variante, pour distinguer les angles. */
  page?: string;
  /** Affiche le champ téléphone (il devient alors obligatoire). */
  avecTelephone?: boolean;
  /** Version compacte : le libellé se loge dans le champ, pour la landing d'un seul écran. */
  compact?: boolean;
  libelles?: { prenom?: string; email?: string; telephone?: string };
  messages?: {
    prenom?: string;
    email?: string;
    telephone?: string;
    echec?: string;
    limite?: string;
    envoi?: string;
  };
}

const {
  id = 'lead',
  suivant,
  bouton,
  source = '',
  page = '',
  avecTelephone = false,
  compact = false,
  libelles = {},
  messages = {},
} = Astro.props;

const l = { prenom: 'Prénom', email: 'Email', telephone: 'Téléphone', ...libelles };

// Pays du champ téléphone : le drapeau se calcule à partir du code du pays.
const drapeau = (code: string) =>
  String.fromCodePoint(...[...code].map((lettre) => 0x1f1e6 + lettre.charCodeAt(0) - 65));
const pays = Object.entries(PAYS_TELEPHONE).map(([code, p]) => ({
  code,
  exemple: p.exemple,
  court: `${drapeau(code)} +${p.indicatif}`,
  long: `${drapeau(code)} ${p.nom} (+${p.indicatif})`,
}));
const m = {
  prenom: 'Indique ton prénom.',
  email: 'Vérifie ton adresse email.',
  telephone: 'Vérifie ton numéro de téléphone.',
  echec: 'L’envoi n’a pas abouti. Réessaie dans un instant.',
  limite: 'Trop d’envois en peu de temps. Réessaie dans quelques minutes.',
  envoi: 'Envoi en cours…',
  ...messages,
};
---

<form
  class:list={['formulaire-lead', { compact }]}
  data-formulaire-lead
  data-suivant={suivant}
  data-source={source}
  data-page={page}
  data-msg-prenom={m.prenom}
  data-msg-email={m.email}
  data-msg-telephone={m.telephone}
  data-msg-echec={m.echec}
  data-msg-limite={m.limite}
  data-msg-envoi={m.envoi}
  novalidate
>
  <div class="champ">
    <label for={`${id}-prenom`}>{l.prenom}</label>
    <input
      id={`${id}-prenom`}
      name="prenom"
      type="text"
      autocomplete="given-name"
      autocapitalize="words"
      enterkeyhint="next"
      maxlength="60"
      required
      aria-describedby={`${id}-prenom-erreur`}
    />
    <p class="message-erreur" id={`${id}-prenom-erreur`} data-erreur="prenom" role="alert"></p>
  </div>

  <div class="champ">
    <label for={`${id}-email`}>{l.email}</label>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint={avecTelephone ? 'next' : 'send'}
      maxlength="254"
      required
      aria-describedby={`${id}-email-erreur`}
    />
    <p class="message-erreur" id={`${id}-email-erreur`} data-erreur="email" role="alert"></p>
  </div>

  {
    avecTelephone && (
      <div class="champ champ-tel">
        <label for={`${id}-telephone`}>{l.telephone}</label>
        <div class="tel-ligne">
          <select name="pays" aria-label="Pays du numéro de téléphone" autocomplete="country">
            {pays.map((p) => (
              <option
                value={p.code}
                data-court={p.court}
                data-long={p.long}
                data-exemple={p.exemple}
                selected={p.code === 'FR'}
              >
                {p.long}
              </option>
            ))}
            <option value="" data-court="🌍 Autre" data-long="🌍 Autre pays" data-exemple="+… ton numéro complet">
              🌍 Autre pays
            </option>
          </select>
          <input
            id={`${id}-telephone`}
            name="telephone"
            type="tel"
            inputmode="tel"
            autocomplete="tel-national"
            enterkeyhint="send"
            maxlength="24"
            placeholder={PAYS_TELEPHONE.FR.exemple}
            required
            aria-describedby={`${id}-telephone-erreur`}
          />
        </div>
        <p class="message-erreur" id={`${id}-telephone-erreur`} data-erreur="telephone" role="alert" />
      </div>
    )
  }

  <!-- Champ piège : invisible pour une personne, rempli par les robots. -->
  <div class="visuellement-cache" aria-hidden="true">
    <label for={`${id}-libre`}>Ne pas remplir ce champ</label>
    <input id={`${id}-libre`} name="af_champ_libre" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button class="bouton bouton-large" type="submit"><span data-libelle>{bouton}</span></button>
  <p class="etat" data-etat role="status" aria-live="polite"></p>
  <slot name="mention" />
</form>

<style>
  .formulaire-lead {
    display: grid;
    gap: 12px;
  }

  .etat {
    color: var(--erreur);
    font-size: var(--corps-petit);
    font-weight: 500;
  }

  .etat:empty {
    display: none;
  }

  /* Téléphone : le pays (drapeau et indicatif) à gauche, le numéro à droite. */
  .tel-ligne {
    display: grid;
    grid-template-columns: 5.7rem minmax(0, 1fr);
    gap: 6px;
  }

  .tel-ligne select {
    min-width: 0;
    padding: 0 4px;
    border: 1.5px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--blanc);
    color: var(--encre);
    font-family: var(--police-texte);
    font-size: var(--corps-champ);
    text-align: center;
    text-align-last: center;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .tel-ligne select:focus-visible {
    outline: 3px solid var(--encre);
    outline-offset: 1px;
    border-color: var(--encre);
  }

  /* Version compacte : le libellé « Téléphone » coiffe le pays, l'indicatif se lit dessous. */
  .compact .tel-ligne select {
    padding-top: 15px;
  }

  /* Version compacte : libellé dans le champ, hauteur réduite. Le texte saisi reste à 16 px. */
  .compact {
    gap: clamp(6px, 1svh, 9px);
  }

  .compact .champ {
    position: relative;
    gap: 2px;
  }

  .compact .champ label {
    position: absolute;
    top: 7px;
    left: 15px;
    color: var(--encre-douce);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  .compact .champ input {
    min-height: 50px;
    padding: 20px 14px 6px;
  }

  .compact .champ .message-erreur {
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .compact .bouton {
    min-height: 52px;
  }
</style>

<script>
  import { PAYS_TELEPHONE, nettoyerEmail, nettoyerPrenom, nettoyerTelephone } from '../../partage/validation.js';
  import { adresseAvecUTM, enregistrerLead, lireUTM } from '../scripts/session';

  const PIEGE = 'af_champ_libre';
  const CHAMPS = ['prenom', 'email', 'telephone'];

  /* Pays probable d'après le fuseau horaire, en attendant la réponse de /api/pays. */
  const FUSEAUX: Record<string, string> = {
    'Europe/Paris': 'FR',
    'Europe/Brussels': 'BE',
    'Europe/Zurich': 'CH',
    'Europe/Luxembourg': 'LU',
    'Europe/Monaco': 'MC',
    'America/Toronto': 'CA',
    'America/Montreal': 'CA',
    'Indian/Reunion': 'RE',
    'America/Guadeloupe': 'GP',
    'America/Martinique': 'MQ',
    'America/Cayenne': 'GF',
    'Indian/Mayotte': 'YT',
    'Pacific/Noumea': 'NC',
    'Pacific/Tahiti': 'PF',
    'Europe/Berlin': 'DE',
    'Europe/Madrid': 'ES',
    'Europe/Rome': 'IT',
    'Europe/Lisbon': 'PT',
    'Europe/Amsterdam': 'NL',
    'Europe/London': 'GB',
    'Europe/Dublin': 'IE',
    'Africa/Casablanca': 'MA',
    'Africa/Algiers': 'DZ',
    'Africa/Tunis': 'TN',
    'Africa/Dakar': 'SN',
    'Africa/Abidjan': 'CI',
  };

  function paysProbable(): string {
    try {
      const fuseau = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (FUSEAUX[fuseau]) return FUSEAUX[fuseau];
    } catch {
      /* fuseau indisponible */
    }
    const region = (navigator.language.split('-')[1] ?? '').toUpperCase();
    return Object.hasOwn(PAYS_TELEPHONE, region) ? region : 'FR';
  }

  /** Une seule demande à /api/pays par page, même avec plusieurs formulaires. */
  let paysSelonIP: Promise<string> | null = null;
  function demanderPays(): Promise<string> {
    paysSelonIP ??= fetch('/api/pays')
      .then((reponse) => (reponse.ok ? reponse.json() : null))
      .then((donnees) => (typeof donnees?.pays === 'string' ? donnees.pays : ''))
      .catch(() => '');
    return paysSelonIP;
  }

  function preparerTelephone(form: HTMLFormElement): void {
    const select = form.elements.namedItem('pays') as HTMLSelectElement | null;
    const numero = form.elements.namedItem('telephone') as HTMLInputElement | null;
    if (!select || !numero) return;
    let choisiALaMain = false;

    // Le pays choisi s'affiche en court (drapeau et indicatif) ; la liste garde les noms.
    const rafraichir = () => {
      for (const option of select.options) {
        option.textContent = (option.selected ? option.dataset.court : option.dataset.long) ?? option.textContent;
      }
      numero.placeholder = select.selectedOptions[0]?.dataset.exemple ?? '';
    };
    const choisir = (code: string) => {
      if ([...select.options].some((option) => option.value === code)) select.value = code;
      rafraichir();
    };

    select.addEventListener('change', () => {
      choisiALaMain = true;
      rafraichir();
    });

    choisir(paysProbable());
    demanderPays().then((code) => {
      if (!code || choisiALaMain || numero.value) return;
      choisir(Object.hasOwn(PAYS_TELEPHONE, code) ? code : '');
    });
  }

  function initialiser(form: HTMLFormElement): void {
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const libelle = form.querySelector<HTMLElement>('[data-libelle]');
    const etat = form.querySelector<HTMLElement>('[data-etat]');
    if (!bouton || !libelle || !etat) return;

    const affichage = Date.now();
    const texteBouton = libelle.textContent ?? '';
    const message = (cle: string) => form.dataset[cle] ?? '';
    const champ = (nom: string) => form.elements.namedItem(nom) as HTMLInputElement | null;
    let envoiEnCours = false;

    preparerTelephone(form);

    function signaler(nom: string, texte: string): void {
      const zone = form.querySelector<HTMLElement>(`[data-erreur="${nom}"]`);
      const saisie = champ(nom);
      if (zone) zone.textContent = texte;
      if (saisie) {
        if (texte) saisie.setAttribute('aria-invalid', 'true');
        else saisie.removeAttribute('aria-invalid');
      }
    }

    function liberer(): void {
      envoiEnCours = false;
      bouton!.disabled = false;
      libelle!.textContent = texteBouton;
    }

    // Une correction efface le message du champ concerné.
    form.addEventListener('input', (evenement) => {
      const cible = evenement.target as HTMLInputElement | null;
      if (cible?.name) signaler(cible.name, '');
      etat.textContent = '';
    });

    // Retour arrière depuis la page suivante : le bouton redevient utilisable.
    window.addEventListener('pageshow', (evenement) => {
      if (evenement.persisted) liberer();
    });

    form.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      if (envoiEnCours) return;

      const prenom = nettoyerPrenom(champ('prenom')?.value ?? '');
      const email = nettoyerEmail(champ('email')?.value ?? '');
      const champTelephone = champ('telephone');
      const pays = (form.elements.namedItem('pays') as HTMLSelectElement | null)?.value ?? 'FR';
      const telephone = champTelephone ? nettoyerTelephone(champTelephone.value, pays) : '';

      const erreurs: [string, string][] = [];
      if (!prenom) erreurs.push(['prenom', message('msgPrenom')]);
      if (!email) erreurs.push(['email', message('msgEmail')]);
      if (champTelephone && !telephone) erreurs.push(['telephone', message('msgTelephone')]);

      CHAMPS.forEach((nom) => signaler(nom, ''));
      etat.textContent = '';
      if (erreurs.length > 0) {
        erreurs.forEach(([nom, texte]) => signaler(nom, texte));
        champ(erreurs[0]![0])?.focus();
        return;
      }

      envoiEnCours = true;
      bouton.disabled = true;
      libelle.textContent = message('msgEnvoi');

      try {
        const reponse = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prenom,
            email,
            telephone: telephone || undefined,
            pays: champTelephone ? pays : undefined,
            source: form.dataset.source || undefined,
            page: form.dataset.page || undefined,
            utm: lireUTM(),
            delai: Date.now() - affichage,
            [PIEGE]: champ(PIEGE)?.value ?? '',
          }),
        });
        const resultat = await reponse.json().catch(() => null);

        if (reponse.ok && resultat?.ok) {
          enregistrerLead({ prenom, email, ...(telephone ? { telephone } : {}) });
          form.dispatchEvent(
            new CustomEvent('lead:envoye', { bubbles: true, detail: { simulation: Boolean(resultat.simulation) } }),
          );
          // Le bouton reste désactivé pendant le changement de page.
          window.location.assign(adresseAvecUTM(form.dataset.suivant || '/'));
          return;
        }

        if (reponse.status === 400 && resultat?.champs) {
          const refuses = CHAMPS.filter((nom) => resultat.champs[nom]);
          refuses.forEach((nom) => signaler(nom, message('msg' + nom.charAt(0).toUpperCase() + nom.slice(1))));
          if (refuses[0]) champ(refuses[0])?.focus();
          else etat.textContent = message('msgEchec');
        } else if (reponse.status === 429) {
          etat.textContent = message('msgLimite');
        } else {
          etat.textContent = message('msgEchec');
        }
      } catch {
        etat.textContent = message('msgEchec');
      }
      liberer();
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-formulaire-lead]').forEach(initialiser);
</script>
