---
/**
 * Preuve sociale : note Trustpilot et titres d'avis publiés, aux couleurs de
 * Trustpilot (étoiles blanches sur carrés verts) pour qu'on les reconnaisse.
 * - Sur mobile : une ligne qui défile lentement, deux sur les grands téléphones.
 * - Sur grand écran : un mur de cartes.
 * Les étoiles reflètent la note réelle : 4,5 étoiles affichées pour 4,6, et la
 * note donnée par chaque autrice sur sa carte.
 */
import { AVIS, TRUSTPILOT } from '../contenu/avis';

const note = TRUSTPILOT.note.toLocaleString('fr-FR', { minimumFractionDigits: 1 });

/** Cinq cases : pleine, demie ou vide. */
function cases(valeur: number): string[] {
  const pleines = Math.floor(valeur);
  const demie = valeur - pleines >= 0.5;
  return Array.from({ length: 5 }, (_, i) => (i < pleines ? 'pleine' : i === pleines && demie ? 'demie' : 'vide'));
}

const moitie = Math.ceil(AVIS.length / 2);
const rangs = [AVIS.slice(0, moitie), AVIS.slice(moitie)];
---

<section class="avis" aria-label="Avis publiés sur Trustpilot">
  <a class="note" href={TRUSTPILOT.profil} target="_blank" rel="noopener">
    <strong>{TRUSTPILOT.mention}</strong>
    <span class="etoiles" role="img" aria-label={`${note} sur 5`}>
      {cases(TRUSTPILOT.etoiles).map((type) => <span class:list={['etoile', type]}>★</span>)}
    </span>
    <span><strong>{note}</strong> sur 5 · {TRUSTPILOT.nombre} avis sur</span>
    <span class="marque"><span aria-hidden="true">★</span>Trustpilot</span>
  </a>
  <div class="defile">
    {
      rangs.map((rang, i) => (
        <ul class:list={['piste', `rang-${i + 1}`]} role="list">
          {[false, true].map((double) =>
            rang.map((avis) => (
              <li class:list={['carte', { double }]} aria-hidden={double ? 'true' : undefined}>
                <span class="etoiles mini" role="img" aria-label={`${avis.note} étoiles sur 5`}>
                  {cases(avis.note).map((type) => <span class:list={['etoile', type]}>★</span>)}
                </span>
                <span class="titre">«&nbsp;{avis.titre}&nbsp;»</span>
                <span class="nom">{avis.nom}</span>
              </li>
            )),
          )}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .avis {
    display: grid;
    gap: clamp(4px, 0.8svh, 8px);
    min-width: 0;
  }

  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px 6px;
    color: var(--encre);
    font-size: 0.78rem;
    line-height: 1.2;
    text-decoration: none;
  }

  /* Étoiles façon Trustpilot : blanches sur carrés verts. */
  .etoiles {
    display: inline-flex;
    gap: 2px;
    flex: none;
  }

  .etoile {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    background: var(--vert-trustpilot);
    color: var(--blanc);
    font-size: 0.8em;
    line-height: 1;
  }

  .etoile.demie {
    background: linear-gradient(90deg, var(--vert-trustpilot) 50%, var(--trait) 50%);
  }

  .etoile.vide {
    background: var(--trait);
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 700;
  }

  .marque span {
    color: var(--vert-trustpilot);
    font-size: 1.25em;
    line-height: 1;
  }

  .defile {
    display: grid;
    gap: 6px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, var(--encre) 7%, var(--encre) 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, var(--encre) 7%, var(--encre) 93%, transparent);
  }

  .piste {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: defilement 60s linear infinite;
  }

  /* Le second rang n'apparaît que sur les grands téléphones, et défile en sens inverse. */
  .rang-2 {
    display: none;
    animation-direction: reverse;
  }

  @media (min-height: 800px) {
    .rang-2 {
      display: flex;
    }
  }

  .carte {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-right: 8px;
    padding: 5px 12px;
    border: 1px solid var(--trait);
    border-radius: 999px;
    background: var(--blanc);
    font-size: 0.75rem;
    line-height: 1.25;
    white-space: nowrap;
  }

  .mini {
    gap: 1px;
    font-size: 0.82em;
  }

  .titre {
    font-weight: 600;
  }

  .nom {
    color: var(--encre-douce);
  }

  @keyframes defilement {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .piste {
      animation: none;
    }

    .defile {
      overflow-x: auto;
    }
  }

  /* Grand écran : un mur de cartes, sans défilement. */
  @media (min-width: 1000px) and (min-height: 521px) {
    .avis {
      grid-template-rows: auto minmax(0, 1fr);
      height: 100%;
      gap: 12px;
    }

    .note {
      justify-content: flex-start;
      gap: 4px 9px;
      font-size: clamp(0.9rem, 1.05vw, 1.1rem);
    }

    .defile {
      display: flex;
      flex-wrap: wrap;
      align-content: flex-start;
      gap: 10px;
      -webkit-mask-image: linear-gradient(180deg, var(--encre) 80%, transparent);
      mask-image: linear-gradient(180deg, var(--encre) 80%, transparent);
    }

    .piste,
    .rang-2 {
      display: contents;
      animation: none;
    }

    .carte {
      flex: 1 1 calc(50% - 10px);
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin: 0;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: clamp(0.8rem, 0.95vw, 0.95rem);
      white-space: normal;
    }

    .double {
      display: none;
    }
  }
</style>
